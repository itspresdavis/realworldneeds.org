{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "codex/remediation-p0-20261127": false
    }
  },
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/rum.js": {
      "maxDuration": 5,
      "memory": 256
    },
    "api/account.js": {
      "maxDuration": 30
    },
    "api/catalog.js": {
      "maxDuration": 30
    },
    "api/workspace.js": {
      "maxDuration": 30,
      "includeFiles": "server/workspace.html"
    },
    "api/corrections.js": {
      "maxDuration": 30
    },
    "api/correction-review.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(join|workspace|account|account.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/corrections(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(media|data|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/src/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/api/correction(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://services1.arcgis.com; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; manifest-src 'self'; media-src 'none'; object-src 'none'; script-src 'self' 'sha256-gNeN2rNq+ZHpN3+zV8eujw2DZ/nzkucckv90GHIEfG0='; style-src 'self' 'unsafe-inline'; worker-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), web-share=(self), geolocation=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/workspace",
      "destination": "/api/workspace"
    }
  ],
  "redirects": [
    {
      "source": "/transparency",
      "destination": "/our-story#transparency",
      "permanent": true
    },
    {
      "source": "/transparency.html",
      "destination": "/our-story#transparency",
      "permanent": true
    },
    {
      "source": "/directory/local/united-states/united-states/:path*",
      "destination": "/directory/united-states",
      "permanent": true
    },
    {
      "source": "/directory/local/united-kingdom/united-kingdom/:path*",
      "destination": "/directory/united-kingdom",
      "permanent": true
    },
    {
      "source": "/directory/local/united-states/new-york/:path*",
      "destination": "/directory/local/united-states/new-york-city/:path*",
      "permanent": true
    },
    {
      "source": "/join",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/join",
      "permanent": true
    },
    {
      "source": "/workspace",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/workspace",
      "permanent": true
    },
    {
      "source": "/api/account",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/api/account",
      "permanent": true
    },
    {
      "source": "/api/catalog",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/api/catalog",
      "permanent": true
    },
    {
      "source": "/api/workspace",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/api/workspace",
      "permanent": true
    },
    {
      "source": "/corrections",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/corrections",
      "permanent": true
    },
    {
      "source": "/api/corrections",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/api/corrections",
      "permanent": true
    },
    {
      "source": "/api/correction-review",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/api/correction-review",
      "permanent": true
    },
    {
      "source": "/account",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/account",
      "permanent": true
    },
    {
      "source": "/api/preferences",
      "has": [
        {
          "type": "host",
          "value": "realworldneeds.org"
        }
      ],
      "destination": "https://www.realworldneeds.org/api/preferences",
      "permanent": true
    }
  ]
}
