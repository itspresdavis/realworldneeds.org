<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#102236">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {{ page_title | default: shop.name | escape }}
      {%- if current_tags %} | tagged {{ current_tags | join: ', ' | escape }}{% endif -%}
      {%- if current_page != 1 %} | page {{ current_page }}{% endif -%}
    </title>

    {%- assign fallback_description = settings.default_meta_description | default: 'Real World Needs connects practical help with needs that can be understood, acted on, and reported clearly.' -%}
    <meta name="description" content="{{ page_description | default: fallback_description | strip_html | escape }}">

    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ page_description | default: fallback_description | strip_html | escape }}">
    {%- if settings.social_share_image != blank -%}
      <meta property="og:image" content="{{ settings.social_share_image | image_url: width: 1200 }}">
      <meta name="twitter:card" content="summary_large_image">
    {%- endif -%}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Real World Needs",
        "url": "{{ shop.url }}"{% if settings.contact_email != blank %},
        "email": {{ settings.contact_email | json }}{% endif %}{% if settings.public_phone != blank %},
        "telephone": {{ settings.public_phone | json }}{% endif %}
      }
    </script>

    {{ content_for_header }}

    {{ 'rwn-base.css' | asset_url | stylesheet_tag }}
    {{ 'rwn-home.css' | asset_url | stylesheet_tag }}
    {{ 'rwn-pages.css' | asset_url | stylesheet_tag }}
    {{ 'rwn-responsive.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'rwn.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'rwn-header' %}

    <main id="MainContent" class="site-main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'rwn-footer' %}
  </body>
</html>
