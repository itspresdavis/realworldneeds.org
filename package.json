{
  "name": "rwn-web-shopify-theme",
  "version": "3.0.0",
  "private": true,
  "description": "Real World Needs Shopify theme",
  "scripts": {
    "audit:links": "node scripts/audit-theme-links.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "validate:json": "node scripts/validate-json.mjs",
    "theme:check": "shopify theme check --path .",
    "theme:info": "shopify theme info --environment production --json",
    "theme:deploy": "shopify theme push --environment production --strict"
  }
}
