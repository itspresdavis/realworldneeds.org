{%- liquid
  assign main_menu = linklists[section.settings.menu]
  assign donation_ready = false
  if settings.donations_enabled and settings.donation_url != blank
    assign donation_ready = true
  endif

  assign supporter_shop = collections['supporter-shop']
  assign shop_url = routes.all_products_collection_url
  if supporter_shop != blank
    assign shop_url = supporter_shop.url
  endif

  assign needs_url = routes.root_url | append: '#needs'
  if pages['needs'] != blank
    assign needs_url = pages['needs'].url
  endif
  assign work_url = routes.root_url | append: '#starting-point'
  if pages['our-work'] != blank
    assign work_url = pages['our-work'].url
  endif
  assign how_url = routes.root_url | append: '#how-it-works'
  if pages['how-it-works'] != blank
    assign how_url = pages['how-it-works'].url
  endif
  assign transparency_url = routes.root_url | append: '#transparency'
  if pages['transparency'] != blank
    assign transparency_url = pages['transparency'].url
  endif
  assign stories_url = routes.root_url | append: '#stories'
  if settings.stories_enabled and blogs['stories'] != blank
    assign stories_url = blogs['stories'].url
  endif
  assign clothing_url = routes.root_url | append: '#clothing'
  if pages['give-clothing'] != blank
    assign clothing_url = pages['give-clothing'].url
  endif
  assign volunteer_url = routes.root_url | append: '#take-part'
  if pages['volunteer'] != blank
    assign volunteer_url = pages['volunteer'].url
  endif
-%}

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="Real World Needs home">
      <span class="wordmark__mark" aria-hidden="true">RWN</span>
      <span class="wordmark__text">Real World Needs</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {%- if main_menu.links.size > 0 -%}
        {%- for link in main_menu.links -%}
          <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ needs_url }}">Needs</a>
        <a href="{{ work_url }}">Our Work</a>
        <a href="{{ how_url }}">How It Works</a>
        <a href="{{ transparency_url }}">Transparency</a>
        <a href="{{ stories_url }}">Stories</a>
        <a href="{{ clothing_url }}">Give Clothing</a>
        <a href="{{ volunteer_url }}">Volunteer</a>
        {%- if settings.merchandise_enabled -%}<a href="{{ shop_url }}">Shop</a>{%- endif -%}
      {%- endif -%}
    </nav>

    <div class="site-header__actions">
      {%- if donation_ready -%}
        <a class="button button--donate" href="{{ settings.donation_url | escape }}">Donate</a>
      {%- endif -%}
      {%- if settings.merchandise_enabled -%}{% render 'rwn-cart-drawer' %}{%- endif -%}

      <details class="mobile-menu" data-mobile-menu>
        <summary class="mobile-menu__summary" aria-label="Open menu">
          <span></span><span></span><span></span>
        </summary>
        <div class="mobile-menu__panel">
          <div class="mobile-menu__masthead">
            <span>Real World Needs</span>
            <p>Real problems.<br>Real solutions.</p>
          </div>
          <nav class="mobile-menu__links" aria-label="Mobile navigation">
            {%- if main_menu.links.size > 0 -%}
              {%- for link in main_menu.links -%}
                <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}{% render 'rwn-icon', icon: 'arrow' %}</a>
              {%- endfor -%}
            {%- else -%}
              <a href="{{ needs_url }}">Needs {% render 'rwn-icon', icon: 'arrow' %}</a>
              <a href="{{ work_url }}">Our Work {% render 'rwn-icon', icon: 'arrow' %}</a>
              <a href="{{ how_url }}">How It Works {% render 'rwn-icon', icon: 'arrow' %}</a>
              <a href="{{ transparency_url }}">Transparency {% render 'rwn-icon', icon: 'arrow' %}</a>
              <a href="{{ stories_url }}">Stories {% render 'rwn-icon', icon: 'arrow' %}</a>
              <a href="{{ clothing_url }}">Give Clothing {% render 'rwn-icon', icon: 'arrow' %}</a>
              <a href="{{ volunteer_url }}">Volunteer {% render 'rwn-icon', icon: 'arrow' %}</a>
              {%- if settings.merchandise_enabled -%}<a href="{{ shop_url }}">Shop {% render 'rwn-icon', icon: 'arrow' %}</a>{%- endif -%}
            {%- endif -%}
          </nav>
          {%- if donation_ready -%}<a class="button button--primary" href="{{ settings.donation_url | escape }}">Donate</a>{%- endif -%}
        </div>
      </details>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "RWN header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary menu"
    }
  ]
}
{% endschema %}
