<section class="password-storefront">
  <div class="password-storefront__inner">
    <div class="password-storefront__copy">
      <p class="password-storefront__brand">Real World Needs</p>
      <h1>The shop is almost ready.</h1>
      <p>Supporter gear, clothing drives, project updates, and practical ways to help will live here. Enter the storefront password to preview the site.</p>
      {% form 'storefront_password', class: 'password-form' %}
        {{ form.errors | default_errors }}
        <div class="field">
          <label for="Password">Storefront password</label>
          <input id="Password" type="password" name="password" autocomplete="current-password">
        </div>
        <button class="button button--primary" type="submit">Enter preview</button>
      {% endform %}
    </div>

    <div class="password-storefront__visual" aria-label="Real World Needs shop preview">
      <div class="password-product password-product--large">
        <span>Supporter Shop</span>
        <strong>Products publish from Shopify</strong>
      </div>
      <div class="password-product">
        <span>Clothing</span>
        <strong>Donation program</strong>
      </div>
      <div class="password-product">
        <span>Needs</span>
        <strong>Verified projects</strong>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RWN password",
  "settings": []
}
{% endschema %}
