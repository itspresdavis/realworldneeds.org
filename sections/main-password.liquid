<section class="password-entrance">
  <div class="password-entrance__media">
    <img src="{{ 'rwn-editorial-clothing-room.jpg' | asset_url }}" width="340" height="231" alt="People organizing clothing in a community space" loading="eager">
    <div class="password-entrance__caption">
      <span>Preview mode</span>
      <p>Editorial imagery is temporary and replaceable.</p>
    </div>
  </div>

  <div class="password-entrance__content">
    <p class="section-kicker">Real World Needs</p>
    <h1>Real problems deserve real solutions.</h1>
    <p>A new organization for practical help, clothing first, and public project records. Enter the storefront password to preview the production theme.</p>

    {% form 'storefront_password', class: 'password-form' %}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="Password">Storefront password</label>
        <input id="Password" type="password" name="password" autocomplete="current-password">
      </div>
      <button class="button button--primary" type="submit">Enter Preview</button>
    {% endform %}

    <div class="password-entrance__signals" aria-label="Real World Needs focus areas">
      <span>Clothing first</span>
      <span>Verified needs</span>
      <span>Clear reporting</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RWN password",
  "settings": []
}
{% endschema %}
