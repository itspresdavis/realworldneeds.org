<section class="hero">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="section-kicker">Real World Needs</p>
      <h1>Opening soon.</h1>
      <p class="lead">The site is being prepared with truth, privacy, accessibility, and launch safety in mind.</p>
      {% form 'storefront_password', class: 'form-grid' %}
        {{ form.errors | default_errors }}
        <div class="field">
          <label for="Password">Password</label>
          <input id="Password" type="password" name="password" autocomplete="current-password">
        </div>
        <button class="button button--primary" type="submit">Enter</button>
      {% endform %}
    </div>
    <div class="hero__visual"><div class="truth-panel"><p>No public claim should publish before it is ready.</p><span>Launch settings keep sensitive actions hidden by default.</span></div></div>
  </div>
</section>

{% schema %}
{
  "name": "RWN password",
  "settings": []
}
{% endschema %}
