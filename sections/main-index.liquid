{%- liquid
  assign donation_ready = false
  if settings.donations_enabled and settings.donation_url != blank
    assign donation_ready = true
  endif

  assign how_page = pages['how-it-works']
  assign needs_page = pages['needs']
  assign clothing_page = pages['give-clothing']
  assign transparency_page = pages['transparency']
  assign supporter_shop = collections['supporter-shop']
  assign all_products_collection = collections.all
  assign shop_collection = supporter_shop
  if shop_collection == blank or shop_collection.products_count == 0
    assign shop_collection = all_products_collection
  endif
  assign shop_url = routes.all_products_collection_url
  if supporter_shop != blank
    assign shop_url = supporter_shop.url
  endif
  assign stories_blog = blogs['stories']
  assign product_count = 0
  if shop_collection != blank
    assign product_count = shop_collection.products_count
  endif
-%}

<section class="store-hero">
  <div class="store-hero__inner">
    <div class="store-hero__copy">
      <h1>{{ section.settings.hero_heading | escape }}</h1>
      <p class="store-hero__text">{{ section.settings.hero_text | escape }}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="{{ shop_url }}">Shop Supporter Gear {% render 'rwn-icon', icon: 'arrow' %}</a>
        {%- if donation_ready -%}
          <a class="button button--secondary" href="{{ settings.donation_url | escape }}">Donate</a>
        {%- endif -%}
        {%- if clothing_page != blank -%}
          <a class="button button--secondary" href="{{ clothing_page.url }}">Give Clothing</a>
        {%- endif -%}
      </div>
    </div>

    <div class="product-stage" aria-label="Supporter shop preview">
      <div class="product-stage__topline">
        <span>Supporter Shop</span>
        <a href="{{ shop_url }}">View all</a>
      </div>
      {%- if product_count > 0 -%}
        <div class="product-stage__grid">
          {%- for product in shop_collection.products limit: 3 -%}
            <a class="product-tile product-tile--hero" href="{{ product.url }}">
              {%- if product.featured_image -%}
                {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
                {{ product.featured_image | image_url: width: 760 | image_tag: loading: 'eager', alt: product_image_alt }}
              {%- else -%}
                <span class="product-tile__image-missing">Image pending</span>
              {%- endif -%}
              <span class="product-tile__title">{{ product.title | escape }}</span>
              <span class="product-tile__price">{{ product.price | money }}</span>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="product-stage__empty">
          <div class="merch-preview" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <h2>The shop is ready for real products.</h2>
          <p>Publish Printify or Shopify products and they will populate this storefront automatically.</p>
          <a class="button button--secondary" href="{{ shop_url }}">Open Shop</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="rwn-section storefront-strip">
  <div class="rwn-section__inner storefront-strip__grid">
    <article>
      <span>01</span>
      <h2>Shop</h2>
      <p>Supporter products live in Shopify, with product pages, cart, checkout, inventory, taxes, and shipping handled by the store.</p>
      <a class="text-link" href="{{ shop_url }}">Browse products</a>
    </article>
    <article>
      <span>02</span>
      <h2>Give</h2>
      <p>Donation buttons stay hidden until a real processor URL is configured. No fake fundraising path, no fake tax language.</p>
      {%- if donation_ready -%}<a class="text-link" href="{{ settings.donation_url | escape }}">Donate</a>{%- endif -%}
    </article>
    <article>
      <span>03</span>
      <h2>Follow</h2>
      <p>Needs, stories, reports, and project updates appear when there is real information to publish.</p>
      {%- if transparency_page != blank -%}<a class="text-link" href="{{ transparency_page.url }}">See the standard</a>{%- endif -%}
    </article>
  </div>
</section>

<section class="rwn-section rwn-section--white shop-section">
  <div class="rwn-section__inner">
    <div class="section-heading-row">
      <div>
        <h2>Supporter Shop</h2>
        <p class="lead">A real Shopify product area, not a decorative afterthought. Products publish here from Shopify and Printify.</p>
      </div>
      <a class="button button--secondary" href="{{ shop_url }}">View Shop</a>
    </div>

    {%- if product_count > 0 -%}
      <div class="product-grid product-grid--featured">
        {%- for product in shop_collection.products limit: 6 -%}
          <article class="product-card product-card--storefront">
            <a href="{{ product.url }}">
              {%- if product.featured_image -%}
                {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
                <div class="product-media">{{ product.featured_image | image_url: width: 760 | image_tag: loading: 'lazy', alt: product_image_alt }}</div>
              {%- else -%}
                <div class="product-media product-media--empty">Image pending</div>
              {%- endif -%}
              <h3>{{ product.title | escape }}</h3>
            </a>
            <p class="price">{{ product.price | money }}</p>
            {%- unless product.available -%}<p class="status-label">Out of stock</p>{%- endunless -%}
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="shop-empty">
        <div>
          <h3>No products are published yet.</h3>
          <p>Add Printify or Shopify products, then assign them to the Supporter Shop collection. This section will turn into a product grid automatically.</p>
        </div>
        <a class="button button--primary" href="{{ shop_url }}">Open product collection</a>
      </div>
    {%- endif -%}
  </div>
</section>

<section class="rwn-section mission-band">
  <div class="rwn-section__inner mission-band__inner">
    <h2>Built like a store. Run like a promise.</h2>
    <p>Real World Needs can sell supporter gear, receive donated clothing, organize projects, and report what happened without inventing impact before it exists.</p>
  </div>
</section>

<section class="rwn-section rwn-section--white">
  <div class="rwn-section__inner split-showcase">
    <div>
      <h2>Clothing, products, projects, and updates all need different paths.</h2>
      <p class="lead">The site now gives each one a real place to live instead of hiding everything behind a generic launch message.</p>
    </div>
    <div class="path-list">
      <article>
        <h3>Supporter products</h3>
        <p>Product pages, collections, cart, and checkout are ready for Shopify merchandise.</p>
        <a class="text-link" href="{{ shop_url }}">Shop</a>
      </article>
      <article>
        <h3>Clothing program</h3>
        <p>Donation and distribution information can publish when real locations or events exist.</p>
        {%- if clothing_page != blank -%}<a class="text-link" href="{{ clothing_page.url }}">Give Clothing</a>{%- endif -%}
      </article>
      <article>
        <h3>Needs board</h3>
        <p>Projects stay honest: no fake totals, no fake urgency, no invented results.</p>
        {%- if needs_page != blank -%}<a class="text-link" href="{{ needs_page.url }}">View Needs</a>{%- endif -%}
      </article>
    </div>
  </div>
</section>

<section class="rwn-section needs-section">
  <div class="rwn-section__inner">
    <div class="section-heading-row">
      <div>
        <h2>Real needs will have receipts.</h2>
        <p class="lead">When public projects exist, they can show status, verification notes, responsible organization, updates, and funding links.</p>
      </div>
      {%- if how_page != blank -%}<a class="button button--secondary" href="{{ how_page.url }}">How It Works</a>{%- endif -%}
    </div>

    {%- assign project_count = 0 -%}
    {%- if settings.projects_enabled and metaobjects.rwn_project.values != blank -%}
      <div class="need-grid">
        {%- for project in metaobjects.rwn_project.values limit: 3 -%}
          {%- assign project_title = project.title.value | default: project.title -%}
          {%- assign project_summary = project.short_summary.value | default: project.short_summary -%}
          {%- assign project_status = project.status.value | default: project.status -%}
          {%- if project_title != blank -%}
            {%- assign project_count = project_count | plus: 1 -%}
            <article class="need-card">
              <span class="status-label">{{ project_status | default: 'Being verified' | escape }}</span>
              <h3>{{ project_title | escape }}</h3>
              {%- if project_summary != blank -%}<p>{{ project_summary | strip_html | escape }}</p>{%- endif -%}
              {%- if project.system.url != blank -%}<a class="text-link" href="{{ project.system.url }}">View need</a>{%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if project_count == 0 -%}
      <div class="need-board-empty">
        <h3>No public needs are posted yet.</h3>
        <p>The board is ready, but it will stay empty until real projects are verified and approved.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if settings.stories_enabled and stories_blog != blank and stories_blog.articles_count > 0 -%}
  <section class="rwn-section rwn-section--white">
    <div class="rwn-section__inner">
      <div class="section-heading-row">
        <div>
          <h2>Latest updates</h2>
          <p class="lead">Stories and reports from the work as it develops.</p>
        </div>
        <a class="button button--secondary" href="{{ stories_blog.url }}">Read Stories</a>
      </div>
      <div class="article-list">
        {%- for article in stories_blog.articles limit: 3 -%}
          <article class="story-card">
            <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            <p class="muted">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 130 | escape }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<section class="rwn-section final-shop-cta">
  <div class="rwn-section__inner final-shop-cta__inner">
    <h2>Start with the shop. Keep the mission visible.</h2>
    <div class="action-row">
      <a class="button button--primary" href="{{ shop_url }}">Shop Supporter Gear</a>
      {%- if transparency_page != blank -%}<a class="button button--quiet" href="{{ transparency_page.url }}">Transparency</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RWN homepage",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Real World Needs"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero text",
      "default": "Supporter gear, clothing drives, project funding, and transparent updates in one place. Shop the merch, follow the work, and help real needs without the fake numbers."
    }
  ]
}
{% endschema %}
