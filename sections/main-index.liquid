{%- liquid
  assign donation_ready = false
  if settings.donations_enabled and settings.donation_url != blank
    assign donation_ready = true
  endif

  assign how_page = pages['how-it-works']
  assign needs_page = pages['needs']
  assign work_page = pages['our-work']
  assign clothing_page = pages['give-clothing']
  assign volunteer_page = pages['volunteer']
  assign transparency_page = pages['transparency']
  assign about_page = pages['about']
  assign supporter_shop = collections['supporter-shop']
  assign shop_collection = supporter_shop
  if shop_collection == blank
    assign shop_collection = collections.all
  endif
  assign shop_url = routes.all_products_collection_url
  if supporter_shop != blank
    assign shop_url = supporter_shop.url
  endif
  assign product_count = 0
  if shop_collection != blank
    assign product_count = shop_collection.products_count
  endif
  assign stories_blog = blogs['stories']
-%}

<section class="home-hero">
  <div class="home-hero__inner">
    <div class="home-hero__copy">
      <h1>{{ section.settings.hero_heading | escape }}</h1>
      <p class="home-hero__lede">{{ section.settings.hero_text | escape }}</p>
      <div class="hero__actions">
        {%- if how_page != blank -%}<a class="button button--primary" href="{{ how_page.url }}">See How It Works</a>{%- endif -%}
        {%- if settings.merchandise_enabled -%}<a class="button button--secondary" href="{{ shop_url }}">Shop Supporter Gear</a>{%- elsif work_page != blank -%}<a class="button button--secondary" href="{{ work_page.url }}">Our Work</a>{%- endif -%}
        {%- if donation_ready -%}<a class="button button--secondary" href="{{ settings.donation_url | escape }}">Donate</a>{%- endif -%}
      </div>
      <dl class="home-hero__signals" aria-label="Real World Needs focus">
        <div>
          <dt>Starting point</dt>
          <dd>Clothing first</dd>
        </div>
        <div>
          <dt>Standard</dt>
          <dd>Records from day one</dd>
        </div>
      </dl>
    </div>

    <div class="home-hero__media" aria-label="Editorial photograph showing organized aid work">
      <div class="home-hero__image">
        {%- if section.settings.hero_image != blank -%}
          {%- assign hero_alt = section.settings.hero_image_alt | default: 'People organizing practical aid together' -%}
          {{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 48vw, 100vw', alt: hero_alt }}
        {%- else -%}
          <img src="{{ 'rwn-editorial-aid-boxes.jpg' | asset_url }}" width="340" height="226" alt="Volunteers organizing boxes of donated supplies at a food bank" loading="eager">
        {%- endif -%}
      </div>
      <div class="home-hero__note">
        <strong>New, on purpose.</strong>
        <span>Real World Needs is starting small so the public record can grow with the work.</span>
      </div>
    </div>
  </div>
</section>

<section class="rwn-section idea-section">
  <div class="rwn-section__inner idea-section__inner">
    <div>
      <h2>Start with what helps most.</h2>
    </div>
    <div class="editorial-prose">
      <p>Real World Needs connects practical help with needs that can be understood, acted on, and reported clearly.</p>
      <p>The work may happen directly or through carefully chosen charitable partners. The standard stays the same: name the need, organize the response, and show the result.</p>
    </div>
  </div>
  <div class="rwn-section__inner idea-principles" aria-label="Real World Needs principles">
    <article>
      <span>Real need</span>
      <p>The situation has to be specific enough to understand and responsible enough to share.</p>
    </article>
    <article>
      <span>Useful help</span>
      <p>Goods, volunteers, funding, skills, and partners are matched to the work in front of them.</p>
    </article>
    <article>
      <span>Dignity</span>
      <p>Programs are designed for people, not for dramatic content.</p>
    </article>
    <article>
      <span>A record</span>
      <p>Public projects need a plain account of what happened and what remains.</p>
    </article>
  </div>
</section>

<section class="rwn-section mission-mosaic">
  <div class="rwn-section__inner mission-mosaic__grid">
    <article class="mission-mosaic__panel">
      <p class="section-kicker">Clothing first</p>
      <h2>Begin with something close enough to do well.</h2>
      <p>Quality clothing is already sitting in homes, closets, businesses, and community spaces. Real World Needs starts there because it is practical, visible, and useful when handled with care.</p>
      {%- if clothing_page != blank -%}<a class="text-link" href="{{ clothing_page.url }}">Give Clothing</a>{%- endif -%}
    </article>
    <div class="mission-mosaic__image mission-mosaic__image--wide">
      {%- if section.settings.clothing_image != blank -%}
        {%- assign clothing_alt = section.settings.clothing_image_alt | default: 'Organized clothing ready for donation' -%}
        {{ section.settings.clothing_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', alt: clothing_alt }}
      {%- else -%}
        <img src="{{ 'rwn-editorial-clothing-rack.jpg' | asset_url }}" width="340" height="226" alt="Organized clothing racks in a community clothing space" loading="lazy">
      {%- endif -%}
    </div>
    <article class="mission-mosaic__panel mission-mosaic__panel--blue">
      <p class="section-kicker">Project transparency</p>
      <h2>Know what happened.</h2>
      <p>Every public project is meant to carry its own record: the need, the responsible party, the support received, the work done, and the outcome.</p>
      {%- if transparency_page != blank -%}<a class="text-link" href="{{ transparency_page.url }}">Explore Transparency</a>{%- endif -%}
    </article>
  </div>
</section>

<section class="rwn-section process-section" id="how-it-works">
  <div class="rwn-section__inner">
    <div class="section-heading-row">
      <div>
        <p class="section-kicker">How Real World Needs Works</p>
        <h2>A simple path from need to record.</h2>
      </div>
      {%- if how_page != blank -%}<a class="button button--secondary" href="{{ how_page.url }}">Read the Model</a>{%- endif -%}
    </div>

    <ol class="process-timeline">
      <li>
        <span>Identify</span>
        <h3>Start with the real situation.</h3>
        <p>A person, family, organization, or community has a need that can be understood and acted on.</p>
      </li>
      <li>
        <span>Verify</span>
        <h3>Get the facts straight.</h3>
        <p>Real World Needs reviews what is known, what is uncertain, and who is responsible for the work.</p>
      </li>
      <li>
        <span>Mobilize</span>
        <h3>Bring the right help together.</h3>
        <p>Support may include clothing, volunteers, funding, professional services, transportation, or a partner organization.</p>
      </li>
      <li>
        <span>Act</span>
        <h3>Do the useful thing.</h3>
        <p>The response is carried out directly or through the organization best suited for the project.</p>
      </li>
      <li>
        <span>Report</span>
        <h3>Leave a public record.</h3>
        <p>Projects can show progress, spending, results, photos, updates, and what remains unfinished.</p>
      </li>
    </ol>
  </div>
</section>

<section class="rwn-section clothing-intro">
  <div class="rwn-section__inner clothing-intro__grid">
    <div class="clothing-intro__media">
      <img src="{{ 'rwn-editorial-clothing-room.jpg' | asset_url }}" width="340" height="231" alt="People sorting donated clothing in a community space" loading="lazy">
    </div>
    <div>
      <p class="section-kicker">The first program</p>
      <h2>Give clothing with care.</h2>
      <p class="lead">The standard is simple: donate what you would feel comfortable giving to someone you care about.</p>
      <div class="editorial-prose">
        <p>Clean, useful clothing can move from closets to people who need it, but only if the process respects quality, organization, dignity, and choice.</p>
      </div>
      <div class="action-row">
        {%- if clothing_page != blank -%}<a class="button button--primary" href="{{ clothing_page.url }}">Give Clothing</a>{%- endif -%}
        {%- if volunteer_page != blank -%}<a class="button button--secondary" href="{{ volunteer_page.url }}">Volunteer</a>{%- endif -%}
      </div>
    </div>
  </div>

  <div class="rwn-section__inner clothing-flow" aria-label="Clothing program process">
    <article><span>Collect</span><p>Accept clean, quality items that someone can actually use.</p></article>
    <article><span>Sort</span><p>Inspect donations by condition, type, size, and season.</p></article>
    <article><span>Prepare</span><p>Make clothing easy to browse and choose.</p></article>
    <article><span>Distribute</span><p>Offer clothing with dignity and choice whenever possible.</p></article>
    <article><span>Document</span><p>Record what was received, moved, and distributed.</p></article>
  </div>
</section>

<section class="rwn-section record-section" id="needs">
  <div class="rwn-section__inner record-section__inner">
    <div class="record-section__copy">
      <p class="section-kicker">Needs and projects</p>
      <h2>Every public need deserves a clear record.</h2>
      <p class="lead">When Real World Needs publishes a project, the page can show what is needed, who is responsible, how support helps, and what happens next.</p>
      <div class="action-row">
        {%- if needs_page != blank -%}<a class="button button--secondary" href="{{ needs_page.url }}">View Needs</a>{%- endif -%}
        {%- if transparency_page != blank -%}<a class="button button--secondary" href="{{ transparency_page.url }}">Transparency</a>{%- endif -%}
      </div>
    </div>

    <div class="record-section__board">
      {%- assign project_count = 0 -%}
      {%- if settings.projects_enabled and metaobjects.rwn_project.values != blank -%}
        <div class="need-grid">
          {%- for project in metaobjects.rwn_project.values limit: 3 -%}
            {%- assign project_title = project.title.value | default: project.title -%}
            {%- assign project_summary = project.short_summary.value | default: project.short_summary -%}
            {%- assign project_status = project.status.value | default: project.status -%}
            {%- assign project_location = project.location.value | default: project.location -%}
            {%- if project_title != blank -%}
              {%- assign project_count = project_count | plus: 1 -%}
              <article class="need-card">
                <div class="need-card__meta">
                  <span class="status-label">{{ project_status | default: 'Being reviewed' | escape }}</span>
                  {%- if project_location != blank -%}<span>{{ project_location | escape }}</span>{%- endif -%}
                </div>
                <h3>{{ project_title | escape }}</h3>
                {%- if project_summary != blank -%}<p>{{ project_summary | strip_html | truncate: 150 | escape }}</p>{%- endif -%}
                {%- if project.system.url != blank -%}<a class="text-link" href="{{ project.system.url }}">View Project</a>{%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if project_count == 0 -%}
        <div class="launch-state launch-state--needs">
          <h3>No public projects are posted right now.</h3>
          <p>The board stays empty until a real need has enough information to publish responsibly.</p>
          {%- if how_page != blank -%}<a class="button button--primary" href="{{ how_page.url }}">How Projects Work</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="rwn-section__inner transparency-ledger" aria-label="Transparency standard">
    <span>Original need</span>
    <span>Responsible party</span>
    <span>Support received</span>
    <span>Expenses</span>
    <span>Updates</span>
    <span>Outcome</span>
  </div>
</section>

<section class="rwn-section stories-section">
  <div class="rwn-section__inner">
    <div class="section-heading-row">
      <div>
        <p class="section-kicker">Good Around the World</p>
        <h2>A place to return to.</h2>
        <p class="lead">Stories can cover Real World Needs updates, completed projects, community work, useful solutions, and good things happening around the world.</p>
      </div>
      {%- if settings.stories_enabled and stories_blog != blank -%}<a class="button button--secondary" href="{{ stories_blog.url }}">Read Stories</a>{%- endif -%}
    </div>

    {%- if settings.stories_enabled and stories_blog != blank and stories_blog.articles_count > 0 -%}
      <div class="publication-grid">
        {%- for article in stories_blog.articles limit: 5 -%}
          <article class="story-card {% if forloop.first %}story-card--feature{% endif %}">
            {%- if article.image -%}
              {%- assign article_image_alt = article.image.alt | default: article.title -%}
              <a class="article-media" href="{{ article.url }}">{{ article.image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: article_image_alt }}</a>
            {%- endif -%}
            <p class="section-kicker">{{ article.tags.first | default: 'Story' | escape }}</p>
            <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            <p class="muted">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 150 | escape }}</p>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="publication-empty">
        <div class="publication-empty__image">
          {%- if section.settings.stories_image != blank -%}
            {%- assign stories_alt = section.settings.stories_image_alt | default: 'People organizing community support' -%}
            {{ section.settings.stories_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', alt: stories_alt }}
          {%- else -%}
            <img src="{{ 'rwn-editorial-volunteers-boxes.jpg' | asset_url }}" width="340" height="242" alt="Volunteers organizing boxes at a community support center" loading="lazy">
          {%- endif -%}
        </div>
        <div>
          <h3>The first stories are not posted right now.</h3>
          <p>This section will become a real publication as posts are added in Shopify. No invented news, no filler posts, no borrowed impact.</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if settings.merchandise_enabled -%}
  <section class="rwn-section shop-section">
    <div class="rwn-section__inner">
      <div class="section-heading-row">
        <div>
          <p class="section-kicker">Supporter Shop</p>
          <h2>Wear the Mission</h2>
          <p class="lead">Printify products imported into Shopify appear here automatically when they are published to the supporter collection.</p>
        </div>
        <a class="button button--secondary" href="{{ shop_url }}">Shop All</a>
      </div>

      {%- if product_count > 0 -%}
        <div class="product-grid product-grid--featured">
          {%- for product in shop_collection.products limit: 4 -%}
            <article class="product-card">
              <a href="{{ product.url }}">
                {%- if product.featured_image -%}
                  {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
                  <div class="product-media">{{ product.featured_image | image_url: width: 760 | image_tag: loading: 'lazy', alt: product_image_alt }}</div>
                {%- else -%}
                  <div class="product-media product-media--empty">Image not available</div>
                {%- endif -%}
                <h3>{{ product.title | escape }}</h3>
              </a>
              <p class="price">{{ product.price | money }}</p>
              {%- unless product.available -%}<p class="status-label">Out of stock</p>{%- endunless -%}
            </article>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="shop-empty shop-empty--home">
          <div>
            <h3>The shop is ready for real products.</h3>
            <p>Connect Printify, publish products in Shopify, and assign them to the Supporter Shop collection. The homepage will turn this space into a real storefront automatically.</p>
          </div>
          <div class="shop-empty__visual" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

<section class="rwn-section ways-section">
  <div class="rwn-section__inner ways-section__inner">
    <div>
      <p class="section-kicker">Ways to Take Part</p>
      <h2>There is more than one way to help.</h2>
    </div>
    <div class="ways-grid">
      {%- if clothing_page != blank -%}<a href="{{ clothing_page.url }}"><span>Give clothing</span><p>Prepare clean, useful items for upcoming collection drives.</p></a>{%- endif -%}
      {%- if volunteer_page != blank -%}<a href="{{ volunteer_page.url }}"><span>Volunteer</span><p>Help with sorting, drives, outreach, logistics, or professional skills.</p></a>{%- endif -%}
      {%- if needs_page != blank -%}<a href="{{ needs_page.url }}"><span>Follow needs</span><p>Watch the project board as reviewed needs are published.</p></a>{%- endif -%}
      {%- if settings.stories_enabled and stories_blog != blank -%}<a href="{{ stories_blog.url }}"><span>Read stories</span><p>Follow updates, field notes, and good work worth sharing.</p></a>{%- endif -%}
      {%- if settings.merchandise_enabled -%}<a href="{{ shop_url }}"><span>Buy merchandise</span><p>Support the mission through real Shopify products.</p></a>{%- endif -%}
      {%- if donation_ready -%}<a href="{{ settings.donation_url | escape }}"><span>Donate</span><p>Give through the configured donation destination.</p></a>{%- endif -%}
    </div>
  </div>
</section>

<section class="rwn-section final-statement">
  <div class="rwn-section__inner final-statement__inner">
    <div>
      <h2>There will always be needs bigger than one organization.</h2>
      <p>There will also always be something real we can do.</p>
    </div>
    <div class="action-row">
      {%- if how_page != blank -%}<a class="button button--primary" href="{{ how_page.url }}">See How It Works</a>{%- endif -%}
      {%- if clothing_page != blank -%}<a class="button button--secondary" href="{{ clothing_page.url }}">Give Clothing</a>{%- endif -%}
      {%- if about_page != blank -%}<a class="button button--secondary" href="{{ about_page.url }}">About RWN</a>{%- endif -%}
      {%- if donation_ready -%}<a class="button button--secondary" href="{{ settings.donation_url | escape }}">Donate</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RWN homepage",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Real problems deserve real solutions."
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero text",
      "default": "Real World Needs connects practical help with needs that can be understood, acted on, and reported clearly."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text"
    },
    {
      "type": "image_picker",
      "id": "clothing_image",
      "label": "Clothing program image"
    },
    {
      "type": "text",
      "id": "clothing_image_alt",
      "label": "Clothing image alt text"
    },
    {
      "type": "image_picker",
      "id": "stories_image",
      "label": "Stories launch image"
    },
    {
      "type": "text",
      "id": "stories_image_alt",
      "label": "Stories image alt text"
    }
  ]
}
{% endschema %}
