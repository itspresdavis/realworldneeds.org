{%- liquid
  assign donation_ready = false
  if settings.donations_enabled and settings.donation_url != blank
    assign donation_ready = true
  endif

  assign how_page = pages['how-it-works']
  assign needs_page = pages['needs']
  assign work_page = pages['our-work']
  assign clothing_page = pages['give-clothing']
  assign volunteer_page = pages['volunteer']
  assign transparency_page = pages['transparency']
  assign about_page = pages['about']

  assign how_url = routes.root_url | append: '#how-it-works'
  if how_page != blank
    assign how_url = how_page.url
  endif
  assign work_url = routes.root_url | append: '#starting-point'
  if work_page != blank
    assign work_url = work_page.url
  endif
  assign needs_url = routes.root_url | append: '#needs'
  if needs_page != blank
    assign needs_url = needs_page.url
  endif
  assign clothing_url = routes.root_url | append: '#clothing'
  if clothing_page != blank
    assign clothing_url = clothing_page.url
  endif
  assign volunteer_url = routes.root_url | append: '#take-part'
  if volunteer_page != blank
    assign volunteer_url = volunteer_page.url
  endif
  assign transparency_url = routes.root_url | append: '#transparency'
  if transparency_page != blank
    assign transparency_url = transparency_page.url
  endif
  assign about_url = routes.root_url | append: '#why-rwn'
  if about_page != blank
    assign about_url = about_page.url
  endif

  assign supporter_shop = collections['supporter-shop']
  assign shop_collection = supporter_shop
  if shop_collection == blank
    assign shop_collection = collections.all
  endif
  assign shop_url = routes.all_products_collection_url
  if supporter_shop != blank
    assign shop_url = supporter_shop.url
  endif
  assign product_count = 0
  if shop_collection != blank
    assign product_count = shop_collection.products_count
  endif

  assign stories_blog = blogs['stories']
  assign stories_url = routes.root_url | append: '#stories'
  if settings.stories_enabled and stories_blog != blank
    assign stories_url = stories_blog.url
  endif
-%}

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__inner">
    <div class="home-hero__copy" data-reveal>
      <h1 id="home-hero-title">{{ section.settings.hero_heading | escape }}</h1>
      <span class="editorial-rule" aria-hidden="true"></span>
      <p class="home-hero__lede">{{ section.settings.hero_text | escape }}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="{{ how_url }}">See How It Works {% render 'rwn-icon', icon: 'arrow' %}</a>
        <a class="button button--secondary" href="{{ work_url }}">Our Work {% render 'rwn-icon', icon: 'arrow' %}</a>
        {%- if donation_ready -%}<a class="button button--text" href="{{ settings.donation_url | escape }}">Donate</a>{%- endif -%}
      </div>
      <div class="home-hero__trust" aria-label="Real World Needs launch position">
        <p><span>Starting point</span>Clothing</p>
        <p><span>Public standard</span>A record from the first project</p>
      </div>
      <a class="scroll-cue" href="#why-rwn">
        <span aria-hidden="true"></span>
        Scroll to explore
      </a>
    </div>

    <figure class="home-hero__media" data-reveal>
      <div class="home-hero__image">
        {%- if section.settings.hero_image != blank -%}
          {%- assign hero_alt = section.settings.hero_image_alt | default: 'Volunteers organizing useful supplies together' -%}
          {{ section.settings.hero_image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '720, 960, 1200, 1600, 2200', sizes: '(min-width: 990px) 56vw, 100vw', alt: hero_alt }}
        {%- else -%}
          <img src="{{ 'rwn-editorial-aid-boxes.jpg' | asset_url }}" width="2400" height="1600" alt="Volunteers sorting clothing and useful supplies in a bright community workspace" loading="eager" fetchpriority="high">
        {%- endif -%}
      </div>
      <figcaption>Editorial photography. Not a Real World Needs project record.</figcaption>
    </figure>
  </div>
</section>

<section class="rwn-section idea-section" id="why-rwn" aria-labelledby="idea-title">
  <div class="rwn-section__inner idea-section__grid">
    <div class="idea-section__statement" data-reveal>
      <p class="section-label">Why Real World Needs</p>
      <h2 id="idea-title">Help should be easier to understand.</h2>
    </div>
    <div class="idea-section__copy" data-reveal>
      <p class="lead">People want to help. Real needs exist everywhere.</p>
      <p>What is often missing is a clear connection between the need, the response, and the result. Real World Needs is being built around that connection.</p>
      <p>The work may be carried out directly or with a qualified charitable partner. Either way, the public record should be clear.</p>
    </div>
    <figure class="idea-section__media" data-reveal>
      <img src="{{ 'rwn-editorial-volunteers-boxes.jpg' | asset_url }}" width="2400" height="1600" alt="Two volunteers recording and organizing donated clothing" loading="lazy">
      <figcaption>Editorial photography. The people shown are not presented as Real World Needs volunteers.</figcaption>
    </figure>
  </div>
</section>

<section class="rwn-section process-story" id="how-it-works" aria-labelledby="process-title" data-process>
  <div class="rwn-section__inner">
    <div class="process-story__heading" data-reveal>
      <p class="section-label">How it works</p>
      <h2 id="process-title">Five steps.<br>One public record.</h2>
    </div>

    <div class="process-story__layout">
      <nav class="process-story__nav" aria-label="How Real World Needs works">
        <ol>
          <li><a href="#process-identify" data-process-link="identify" aria-current="step"><span>01</span>Identify</a></li>
          <li><a href="#process-verify" data-process-link="verify"><span>02</span>Verify</a></li>
          <li><a href="#process-mobilize" data-process-link="mobilize"><span>03</span>Mobilize</a></li>
          <li><a href="#process-act" data-process-link="act"><span>04</span>Act</a></li>
          <li><a href="#process-report" data-process-link="report"><span>05</span>Report</a></li>
        </ol>
      </nav>

      <div class="process-story__steps">
        <article id="process-identify" class="process-step" data-process-step="identify" data-reveal>
          <figure class="process-step__media">
            <img src="{{ 'rwn-editorial-clothing-room.jpg' | asset_url }}" width="2400" height="1600" alt="Volunteers checking and sorting donated clothing in a bright workspace" loading="lazy">
            <figcaption>Editorial photography. Not a Real World Needs project record.</figcaption>
          </figure>
          <div class="process-step__copy"><span>01</span><h3>Start with something real.</h3><p>A person, family, organization, or community has a need that can be understood and acted on.</p></div>
        </article>
        <article id="process-verify" class="process-step" data-process-step="verify" data-reveal>
          <div class="process-step__copy"><span>02</span><h3>Understand what is actually required.</h3><p>Before a project is presented, the situation is reviewed. What is known, what is uncertain, and who is responsible should be stated plainly.</p></div>
        </article>
        <article id="process-mobilize" class="process-step" data-process-step="mobilize" data-reveal>
          <div class="process-step__copy"><span>03</span><h3>Bring together what can help.</h3><p>That may mean clothing, volunteers, funding, professional services, local businesses, transportation, or a charitable partner.</p></div>
        </article>
        <article id="process-act" class="process-step" data-process-step="act" data-reveal>
          <div class="process-step__copy"><span>04</span><h3>Turn support into useful work.</h3><p>Real World Needs may carry out the response directly or support an organization that is better placed to do it.</p></div>
        </article>
        <article id="process-report" class="process-step" data-process-step="report" data-reveal>
          <div class="process-step__copy"><span>05</span><h3>Show what happened.</h3><p>The public should be able to follow the work, understand spending where appropriate, and see what changed or remains unfinished.</p></div>
          <a class="text-link text-link--arrow" href="{{ how_url }}">Read the full process {% render 'rwn-icon', icon: 'arrow' %}</a>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="rwn-section clothing-story" id="clothing" aria-labelledby="clothing-title">
  <figure class="clothing-story__media" data-reveal>
    {%- if section.settings.clothing_image != blank -%}
      {%- assign clothing_alt = section.settings.clothing_image_alt | default: 'People sorting and organizing donated clothing' -%}
      {{ section.settings.clothing_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '720, 960, 1200, 1600, 2200', sizes: '100vw', alt: clothing_alt }}
    {%- else -%}
      <img src="{{ 'rwn-editorial-clothing-room.jpg' | asset_url }}" width="2400" height="1600" alt="Volunteers checking and sorting donated clothing in a bright workspace" loading="lazy">
    {%- endif -%}
    <figcaption>Editorial photography. Not a Real World Needs project record.</figcaption>
  </figure>

  <div class="rwn-section__inner clothing-story__intro" id="starting-point">
    <div data-reveal>
      <p class="section-label">The first program</p>
      <h2 id="clothing-title"><span>We are starting with something simple.</span>Clothing.</h2>
    </div>
    <div class="clothing-story__copy" data-reveal>
      <p>Useful clothing already exists in closets, homes, businesses, and communities.</p>
      <p>The first Real World Needs program will collect quality clothing, organize it properly, and put it where it can actually be used.</p>
      <div class="action-row">
        <a class="button button--primary" href="{{ clothing_url }}">Give Clothing {% render 'rwn-icon', icon: 'arrow' %}</a>
        <a class="button button--secondary" href="{{ volunteer_url }}">Volunteer {% render 'rwn-icon', icon: 'arrow' %}</a>
      </div>
    </div>
  </div>

  <div class="rwn-section__inner clothing-sequence" aria-label="Planned clothing program process" data-reveal>
    <ol>
      <li><span>01</span><strong>Collect</strong><p>Receive clean clothing that someone can use.</p></li>
      <li><span>02</span><strong>Inspect</strong><p>Remove anything damaged, unsafe, or unsuitable.</p></li>
      <li><span>03</span><strong>Sort</strong><p>Organize by type, size, condition, and season.</p></li>
      <li><span>04</span><strong>Prepare</strong><p>Make useful items easy to browse and choose.</p></li>
      <li><span>05</span><strong>Distribute</strong><p>Offer clothing with dignity and choice.</p></li>
      <li><span>06</span><strong>Document</strong><p>Record what was received and where it went.</p></li>
    </ol>
    <p class="clothing-standard">Donate what you would feel comfortable giving to someone you care about.</p>
  </div>
</section>

<section class="rwn-section needs-stage" id="needs" aria-labelledby="needs-title">
  <div class="rwn-section__inner needs-stage__inner">
    <div class="needs-stage__copy" data-reveal>
      <p class="section-label">Future needs</p>
      <h2 id="needs-title">This is where the work will live.</h2>
      <p>Every public need will have a place here.</p>
      <ul class="plain-list">
        <li>What is needed.</li>
        <li>Why it matters.</li>
        <li>Who is responsible.</li>
        <li>What support is being used for.</li>
        <li>What happened next.</li>
      </ul>
      <a class="button button--outline-light" href="{{ needs_url }}">See How Projects Will Work {% render 'rwn-icon', icon: 'arrow' %}</a>
    </div>

    <div class="needs-stage__records" data-reveal>
      {%- assign project_count = 0 -%}
      {%- if settings.projects_enabled and metaobjects.rwn_project.values != blank -%}
        <div class="need-grid">
          {%- for project in metaobjects.rwn_project.values limit: 3 -%}
            {%- assign project_title = project.title.value | default: project.title -%}
            {%- assign project_summary = project.short_summary.value | default: project.short_summary -%}
            {%- assign project_status = project.status.value | default: project.status -%}
            {%- assign project_location = project.location.value | default: project.location -%}
            {%- assign project_image = project.featured_image.value | default: project.featured_image -%}
            {%- if project_title != blank -%}
              {%- assign project_count = project_count | plus: 1 -%}
              <article class="need-card">
                {%- if project_image != blank -%}
                  <a class="need-card__media" href="{{ project.system.url }}">{{ project_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: project_title }}</a>
                {%- endif -%}
                <div class="need-card__meta"><span>{{ project_status | default: 'Being reviewed' | escape }}</span>{%- if project_location != blank -%}<span>{{ project_location | escape }}</span>{%- endif -%}</div>
                <h3>{{ project_title | escape }}</h3>
                {%- if project_summary != blank -%}<p>{{ project_summary | strip_html | truncate: 145 | escape }}</p>{%- endif -%}
                {%- if project.system.url != blank -%}<a class="text-link text-link--arrow" href="{{ project.system.url }}">View Project {% render 'rwn-icon', icon: 'arrow' %}</a>{%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if project_count == 0 -%}
        <div class="public-record-frame" aria-label="Future public need record">
          <span class="public-record-frame__top">Public need record</span>
          <span class="public-record-frame__left">What is needed</span>
          <span class="public-record-frame__right">Who is responsible</span>
          <span class="public-record-frame__bottom">What happened next</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="rwn-section transparency-story" id="transparency" aria-labelledby="transparency-title">
  <div class="rwn-section__inner transparency-story__grid">
    <div class="transparency-story__copy" data-reveal>
      <p class="section-label">Transparency</p>
      <h2 id="transparency-title">You should never have to wonder where your help went.</h2>
      <p class="lead">Transparency should begin before the first project.</p>
      <a class="button button--secondary" href="{{ transparency_url }}">Explore Our Transparency Standard {% render 'rwn-icon', icon: 'arrow' %}</a>
    </div>
    <ol class="transparency-record" aria-label="Information available in a future public project record" data-reveal>
      <li><span>The need</span></li>
      <li><span>The plan</span></li>
      <li><span>Money received</span></li>
      <li><span>Money spent</span></li>
      <li><span>Project updates</span></li>
      <li><span>Receipts where appropriate</span></li>
      <li><span>Responsible organization</span></li>
      <li><span>Current status</span></li>
      <li><span>Final outcome</span></li>
    </ol>
  </div>
</section>

<section class="rwn-section stories-stage" id="stories" aria-labelledby="stories-title">
  <div class="rwn-section__inner stories-stage__inner">
    <header class="stories-stage__heading" data-reveal>
      <p class="publication-mark">Good Around the World</p>
      <h2 id="stories-title">Stories worth coming back for.</h2>
      <p>Useful solutions. Honest updates. Good work worth knowing about.</p>
      {%- if settings.stories_enabled and stories_blog != blank -%}<a class="text-link text-link--arrow" href="{{ stories_blog.url }}">Visit Stories {% render 'rwn-icon', icon: 'arrow' %}</a>{%- endif -%}
    </header>

    {%- if settings.stories_enabled and stories_blog != blank and stories_blog.articles_count > 0 -%}
      <div class="publication-layout" data-reveal>
        {%- for article in stories_blog.articles limit: 5 -%}
          {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
          {%- assign read_time = word_count | divided_by: 220 -%}
          {%- if read_time < 1 -%}{%- assign read_time = 1 -%}{%- endif -%}
          <article class="story-card {% if forloop.first %}story-card--feature{% endif %}">
            {%- if article.image -%}
              {%- assign article_image_alt = article.image.alt | default: article.title -%}
              <a class="article-media" href="{{ article.url }}">{{ article.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1400', alt: article_image_alt }}</a>
            {%- endif -%}
            <div class="story-card__body">
              <p class="section-label">{{ article.tags.first | default: 'Story' | escape }}</p>
              <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              <p class="story-card__meta">{{ article.published_at | date: '%B %d, %Y' }} | {{ read_time }} min read</p>
              {%- if forloop.first -%}<p>{{ article.excerpt_or_content | strip_html | truncate: 180 | escape }}</p>{%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="publication-launch" data-reveal>
        <figure>
          {%- if section.settings.stories_image != blank -%}
            {%- assign stories_alt = section.settings.stories_image_alt | default: 'Volunteers packing useful donated goods' -%}
            {{ section.settings.stories_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '720, 960, 1200, 1600, 1800', alt: stories_alt }}
          {%- else -%}
            <img src="{{ 'rwn-editorial-lagos-food-bank.jpg' | asset_url }}" width="2400" height="1600" alt="Lagos Food Bank Initiative volunteers carrying food boxes in Lagos, Nigeria" loading="lazy">
          {%- endif -%}
          <figcaption>Lagos Food Bank Initiative volunteers in Nigeria. Photograph via Pexels. This is not Real World Needs work.</figcaption>
        </figure>
        <div class="publication-launch__copy">
          <p class="section-label">Publication launch</p>
          <h3>The first stories are still being prepared.</h3>
          <p>When articles are published, this space will hold Real World Needs updates, project reporting, practical ideas, and good work from around the world.</p>
          <div class="publication-lines" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{%- if settings.merchandise_enabled and product_count > 0 -%}
  <section class="rwn-section shop-stage" aria-labelledby="shop-title">
    <div class="rwn-section__inner">
      <div class="section-heading-row" data-reveal>
        <div><p class="section-label">Supporter Shop</p><h2 id="shop-title">Wear the Mission</h2><p>Simple pieces for people who believe real problems deserve real action.</p></div>
        <a class="text-link text-link--arrow" href="{{ shop_url }}">Shop All {% render 'rwn-icon', icon: 'arrow' %}</a>
      </div>
      <div class="product-grid product-grid--featured" data-reveal>
        {%- for product in shop_collection.products limit: 4 -%}
          <article class="product-card">
            <a href="{{ product.url }}">
              {%- if product.featured_image -%}
                {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
                <div class="product-media">{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: product_image_alt }}</div>
              {%- endif -%}
              <h3>{{ product.title | escape }}</h3>
            </a>
            <p class="price">{{ product.price | money }}</p>
            {%- unless product.available -%}<p class="availability-label">Out of stock</p>{%- endunless -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<section class="rwn-section take-part" id="take-part" aria-labelledby="take-part-title">
  <div class="rwn-section__inner take-part__inner">
    <h2 id="take-part-title" data-reveal>Ways to take part.</h2>
    <nav class="take-part__links" aria-label="Ways to take part" data-reveal>
      <a href="{{ clothing_url }}"><span>Give clothing</span>{% render 'rwn-icon', icon: 'arrow' %}</a>
      <a href="{{ volunteer_url }}"><span>Volunteer</span>{% render 'rwn-icon', icon: 'arrow' %}</a>
      <a href="{{ stories_url }}"><span>Read Stories</span>{% render 'rwn-icon', icon: 'arrow' %}</a>
      {%- if settings.merchandise_enabled -%}<a href="{{ shop_url }}"><span>Shop</span>{% render 'rwn-icon', icon: 'arrow' %}</a>{%- endif -%}
      {%- if donation_ready -%}<a href="{{ settings.donation_url | escape }}"><span>Donate</span>{% render 'rwn-icon', icon: 'arrow' %}</a>{%- endif -%}
    </nav>
  </div>
</section>

<section class="rwn-section final-statement" aria-labelledby="final-title">
  <div class="rwn-section__inner final-statement__inner" data-reveal>
    <h2 id="final-title">There will always be needs bigger than one organization.</h2>
    <p>There will also always be something real we can do.</p>
    <div class="action-row">
      <a class="button button--outline-light" href="{{ how_url }}">See How It Works {% render 'rwn-icon', icon: 'arrow' %}</a>
      <a class="button button--text-light" href="{{ clothing_url }}">Give Clothing {% render 'rwn-icon', icon: 'arrow' %}</a>
      <a class="button button--text-light" href="{{ about_url }}">About Real World Needs {% render 'rwn-icon', icon: 'arrow' %}</a>
      {%- if donation_ready -%}<a class="button button--text-light" href="{{ settings.donation_url | escape }}">Donate {% render 'rwn-icon', icon: 'arrow' %}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RWN homepage",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Real problems deserve real solutions."
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero text",
      "default": "Real World Needs connects people who want to help with needs that can actually be solved. We understand the need, organize the response, follow the work, and show what happened."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text"
    },
    {
      "type": "image_picker",
      "id": "clothing_image",
      "label": "Clothing program image"
    },
    {
      "type": "text",
      "id": "clothing_image_alt",
      "label": "Clothing image alt text"
    },
    {
      "type": "image_picker",
      "id": "stories_image",
      "label": "Stories image"
    },
    {
      "type": "text",
      "id": "stories_image_alt",
      "label": "Stories image alt text"
    }
  ]
}
{% endschema %}
