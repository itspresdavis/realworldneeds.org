{%- liquid
  assign donation_ready = false
  if settings.donations_enabled and settings.donation_url != blank
    assign donation_ready = true
  endif
  assign how_page = pages['how-it-works']
  assign needs_page = pages['needs']
  assign clothing_page = pages['give-clothing']
  assign volunteer_page = pages['volunteer']
  assign help_page = pages['get-help']
  assign transparency_page = pages['transparency']
  assign supporter_shop = collections['supporter-shop']
  assign stories_blog = blogs['stories']
-%}

<section class="hero">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="section-kicker">Real problems. Real solutions.</p>
      <h1>{{ section.settings.hero_heading | escape }}</h1>
      <p class="lead">{{ section.settings.hero_text | escape }}</p>
      <div class="hero__actions">
        {%- if how_page != blank -%}
          <a class="button button--primary" href="{{ how_page.url }}">See How It Works {% render 'rwn-icon', icon: 'arrow' %}</a>
        {%- endif -%}
        {%- if needs_page != blank and settings.projects_enabled -%}
          <a class="button button--secondary" href="{{ needs_page.url }}">Explore Needs</a>
        {%- endif -%}
        {%- if donation_ready -%}
          <a class="button button--secondary" href="{{ settings.donation_url | escape }}">Donate</a>
        {%- endif -%}
      </div>
    </div>
    <div class="hero__visual" aria-label="Real World Needs launch visual">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1200 | image_tag: class: 'hero__image', loading: 'eager', sizes: '(min-width: 990px) 44vw, 100vw', alt: section.settings.hero_image_alt }}
      {%- endif -%}
      <div class="truth-panel">
        <p>Transparency starts before the first project.</p>
        <span>No invented impact numbers. No invented partners. No invented stories.</span>
      </div>
    </div>
  </div>
</section>

<section class="rwn-section rwn-section--white">
  <div class="rwn-section__inner">
    <p class="section-kicker">The idea</p>
    <h2>A practical system for needs that can be seen, understood, and followed.</h2>
    <div class="editorial-grid" style="margin-top:2rem">
      <article class="editorial-card editorial-card--large">
        <h3>Real World Needs can grow without changing its promise.</h3>
        <p>It can run direct projects, work with vetted charitable partners, receive donated goods, mobilize volunteers, fund verified needs, and publish what happened afterward.</p>
      </article>
      <article class="editorial-card">
        <h3>Start with the need.</h3>
        <p>No campaign should begin with pressure. It should begin with what is known, what is missing, and what responsible help can do.</p>
      </article>
      <article class="editorial-card">
        <h3>Show the work.</h3>
        <p>Published projects should be able to show status, updates, expenses, receipts where appropriate, and final outcomes.</p>
      </article>
    </div>
  </div>
</section>

<section class="rwn-section">
  <div class="rwn-section__inner">
    <p class="section-kicker">How it works</p>
    <h2>Five steps that keep the work grounded.</h2>
    <ol class="step-list">
      <li>
        <div>
          <h3>Identify</h3>
          <p>A need is found through direct work, community awareness, partner referrals, or verified public information.</p>
        </div>
      </li>
      <li>
        <div>
          <h3>Verify</h3>
          <p>Before asking people to act, Real World Needs records what is known, what is uncertain, and who is responsible.</p>
        </div>
      </li>
      <li>
        <div>
          <h3>Mobilize</h3>
          <p>The response may involve donated goods, volunteers, funding, partner support, or direct Real World Needs programs.</p>
        </div>
      </li>
      <li>
        <div>
          <h3>Act</h3>
          <p>Support is organized around the actual need, not around pressure tactics or false urgency.</p>
        </div>
      </li>
      <li>
        <div>
          <h3>Report</h3>
          <p>Updates and final reports show what happened, what changed, and what still needs to be done.</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<section class="rwn-section rwn-section--navy">
  <div class="rwn-section__inner">
    <p class="section-kicker">Starting with clothing</p>
    <h2>Useful clothing can meet a real need with dignity.</h2>
    <p class="lead">The first intended focus is simple: collect quality clothing, sort it carefully, organize distribution opportunities, and document the results without publishing private beneficiary information.</p>
    <div class="status-strip" aria-label="Clothing program steps">
      <div><strong>Collect</strong><p>Quality clothing is donated through approved opportunities.</p></div>
      <div><strong>Sort</strong><p>Volunteers inspect, organize, and prepare useful items.</p></div>
      <div><strong>Distribute</strong><p>Events or partner distributions help people choose what they need.</p></div>
      <div><strong>Document</strong><p>Public updates show what happened when real data exists.</p></div>
    </div>
    <div class="action-row">
      {%- if settings.clothing_program_enabled and clothing_page != blank -%}
        <a class="button button--primary" href="{{ clothing_page.url }}">Give Clothing</a>
      {%- endif -%}
      {%- if settings.volunteer_applications_enabled and volunteer_page != blank -%}
        <a class="button button--quiet" href="{{ volunteer_page.url }}">Volunteer</a>
      {%- endif -%}
      {%- if help_page != blank -%}
        <a class="button button--quiet" href="{{ help_page.url }}">Find Clothing Help</a>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="rwn-section rwn-section--white">
  <div class="rwn-section__inner">
    <p class="section-kicker">Real needs</p>
    <h2>Public needs will appear when they are ready to be published.</h2>
    {%- assign project_count = 0 -%}
    {%- if settings.projects_enabled and metaobjects.rwn_project.values != blank -%}
      <div class="need-grid">
        {%- for project in metaobjects.rwn_project.values limit: 3 -%}
          {%- assign project_title = project.title.value | default: project.title -%}
          {%- assign project_summary = project.short_summary.value | default: project.short_summary -%}
          {%- assign project_status = project.status.value | default: project.status -%}
          {%- if project_title != blank -%}
            {%- assign project_count = project_count | plus: 1 -%}
            <article class="need-card">
              <span class="status-label">{{ project_status | default: 'Being verified' | escape }}</span>
              <h3>{{ project_title | escape }}</h3>
              {%- if project_summary != blank -%}
                <p>{{ project_summary | strip_html | escape }}</p>
              {%- endif -%}
              {%- if project.system.url != blank -%}
                <a class="text-link" href="{{ project.system.url }}">View need</a>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if project_count == 0 -%}
      <div class="empty-state">
        <h3>Our first public needs will appear here.</h3>
        <p>Every project published by Real World Needs should include what is needed, who is responsible, how support is being used, and what happens next.</p>
        {%- if how_page != blank -%}
          <a class="button button--secondary" href="{{ how_page.url }}">Learn how the project system works</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<section class="rwn-section">
  <div class="rwn-section__inner">
    <p class="section-kicker">Transparency</p>
    <h2>You should never have to wonder where your help went.</h2>
    <p class="lead">The launch site does not show invented charts or empty financial claims. As real projects and reports exist, the transparency system can publish project status, money received, money spent, receipts where appropriate, updates, and final results.</p>
    <div class="action-row">
      {%- if transparency_page != blank -%}
        <a class="button button--primary" href="{{ transparency_page.url }}">Read the transparency standard</a>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="rwn-section rwn-section--white">
  <div class="rwn-section__inner">
    <p class="section-kicker">Good in the world</p>
    <h2>A publication for real updates, useful reporting, and practical hope.</h2>
    {%- if settings.stories_enabled and stories_blog != blank and stories_blog.articles_count > 0 -%}
      <div class="article-list">
        {%- for article in stories_blog.articles limit: 3 -%}
          <article class="story-card">
            <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            <p class="muted">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 130 | escape }}</p>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">
        <h3>No stories have been published yet.</h3>
        <p>Stories will clearly distinguish Real World Needs projects, Real World Needs reporting, partner projects, and external positive stories.</p>
      </div>
    {%- endif -%}
  </div>
</section>

<section class="rwn-section">
  <div class="rwn-section__inner">
    <p class="section-kicker">Ways to participate</p>
    <h2>Help can take more than one form.</h2>
    <div class="resource-list">
      {%- if donation_ready -%}
        <article class="policy-card"><h3>Donate</h3><p>Support general giving when the donation processor is configured.</p><a class="text-link" href="{{ settings.donation_url | escape }}">Donate</a></article>
      {%- endif -%}
      {%- if settings.clothing_program_enabled and clothing_page != blank -%}
        <article class="policy-card"><h3>Give clothing</h3><p>Prepare useful clothing for future collection opportunities.</p><a class="text-link" href="{{ clothing_page.url }}">Give Clothing</a></article>
      {%- endif -%}
      {%- if settings.volunteer_applications_enabled and volunteer_page != blank -%}
        <article class="policy-card"><h3>Volunteer</h3><p>Help inspect, sort, organize, and support practical programs.</p><a class="text-link" href="{{ volunteer_page.url }}">Volunteer</a></article>
      {%- endif -%}
      {%- if stories_blog != blank and settings.stories_enabled -%}
        <article class="policy-card"><h3>Read and share stories</h3><p>Follow updates and thoughtful reporting as the publication grows.</p><a class="text-link" href="{{ stories_blog.url }}">Read Stories</a></article>
      {%- endif -%}
      {%- if settings.merchandise_enabled and supporter_shop != blank and supporter_shop.products_count > 0 -%}
        <article class="policy-card"><h3>Shop merchandise</h3><p>Supporter products are secondary to the mission and are fulfilled through Shopify.</p><a class="text-link" href="{{ supporter_shop.url }}">Visit the Shop</a></article>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if settings.merchandise_enabled and supporter_shop != blank and supporter_shop.products_count > 0 -%}
  <section class="rwn-section rwn-section--white">
    <div class="rwn-section__inner">
      <p class="section-kicker">Supporter shop</p>
      <h2>Wear the Mission</h2>
      <div class="product-grid">
        {%- for product in supporter_shop.products limit: 3 -%}
          <article class="product-card">
            <a href="{{ product.url }}">
              {%- if product.featured_image -%}
                {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
                <div class="product-media">{{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', alt: product_image_alt }}</div>
              {%- endif -%}
              <h3>{{ product.title | escape }}</h3>
            </a>
            <p class="price">{{ product.price | money }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<section class="rwn-section rwn-section--navy">
  <div class="rwn-section__inner">
    <h2>The beginning should still be honest.</h2>
    <p class="lead">Real World Needs can start small and still be serious. The first public version of this site is built to explain the model, protect trust, and make room for real work when it is ready.</p>
    <div class="action-row">
      {%- if how_page != blank -%}
        <a class="button button--primary" href="{{ how_page.url }}">See How It Works</a>
      {%- endif -%}
      {%- if transparency_page != blank -%}
        <a class="button button--quiet" href="{{ transparency_page.url }}">View Transparency</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RWN homepage",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Real problems deserve real solutions."
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero text",
      "default": "Real World Needs is being built to connect people who want to help with real needs that can actually be solved. We identify the need, organize the response, track the work, and show what happened."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text"
    }
  ]
}
{% endschema %}
