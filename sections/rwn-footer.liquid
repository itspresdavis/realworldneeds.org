{%- liquid
  assign donation_ready = false
  if settings.donations_enabled and settings.donation_url != blank
    assign donation_ready = true
  endif
  assign supporter_shop = collections['supporter-shop']
  assign shop_url = routes.all_products_collection_url
  if supporter_shop != blank
    assign shop_url = supporter_shop.url
  endif
  assign stories_url = routes.root_url | append: '#stories'
  if settings.stories_enabled and blogs['stories'] != blank
    assign stories_url = blogs['stories'].url
  endif
  assign needs_url = routes.root_url | append: '#needs'
  if pages['needs'] != blank
    assign needs_url = pages['needs'].url
  endif
  assign work_url = routes.root_url | append: '#starting-point'
  if pages['our-work'] != blank
    assign work_url = pages['our-work'].url
  endif
  assign how_url = routes.root_url | append: '#how-it-works'
  if pages['how-it-works'] != blank
    assign how_url = pages['how-it-works'].url
  endif
  assign transparency_url = routes.root_url | append: '#transparency'
  if pages['transparency'] != blank
    assign transparency_url = pages['transparency'].url
  endif
  assign clothing_url = routes.root_url | append: '#clothing'
  if pages['give-clothing'] != blank
    assign clothing_url = pages['give-clothing'].url
  endif
  assign volunteer_url = routes.root_url | append: '#take-part'
  if pages['volunteer'] != blank
    assign volunteer_url = pages['volunteer'].url
  endif
-%}

<footer class="site-footer">
  <div class="site-footer__statement">
    <p>Real problems.<br>Real solutions.</p>
    <span>Real World Needs connects genuine needs with practical action, then shows what happened.</span>
  </div>

  <div class="site-footer__grid">
    <div class="site-footer__brand">
      <a class="wordmark wordmark--footer" href="{{ routes.root_url }}" aria-label="Real World Needs home">
        <span class="wordmark__mark" aria-hidden="true">RWN</span>
        <span class="wordmark__text">Real World Needs</span>
      </a>
      {%- if settings.organization_status_text != blank -%}<p>{{ settings.organization_status_text | escape }}</p>{%- endif -%}
      <div class="site-footer__contact">
        {%- if settings.contact_email != blank -%}<a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a>{%- endif -%}
        {%- if settings.public_phone != blank -%}<a href="tel:{{ settings.public_phone | escape }}">{{ settings.public_phone | escape }}</a>{%- endif -%}
        {%- if settings.public_address != blank -%}<p>{{ settings.public_address | escape | newline_to_br }}</p>{%- endif -%}
      </div>
    </div>

    <nav aria-label="Explore">
      <h2>Explore</h2>
      <a href="{{ needs_url }}">Needs</a>
      <a href="{{ work_url }}">Our Work</a>
      <a href="{{ how_url }}">How It Works</a>
      <a href="{{ transparency_url }}">Transparency</a>
      <a href="{{ stories_url }}">Stories</a>
    </nav>

    <nav aria-label="Get involved">
      <h2>Take Part</h2>
      <a href="{{ clothing_url }}">Give Clothing</a>
      <a href="{{ volunteer_url }}">Volunteer</a>
      {%- if settings.merchandise_enabled -%}<a href="{{ shop_url }}">Supporter Shop</a>{%- endif -%}
      {%- if donation_ready -%}<a href="{{ settings.donation_url | escape }}">Donate</a>{%- endif -%}
      {% render 'rwn-page-link', handle: 'get-help', label: 'Get Help', class: 'footer-link' %}
    </nav>

    <nav aria-label="Organization">
      <h2>Organization</h2>
      {% render 'rwn-page-link', handle: 'about', label: 'About', class: 'footer-link' %}
      {% render 'rwn-page-link', handle: 'governance', label: 'Governance', class: 'footer-link' %}
      {% render 'rwn-page-link', handle: 'financials', label: 'Financials', class: 'footer-link' %}
      {% render 'rwn-page-link', handle: 'contact', label: 'Contact', class: 'footer-link' %}
      {% render 'rwn-page-link', handle: 'faq', label: 'FAQ', class: 'footer-link' %}
    </nav>

    <div class="site-footer__last">
      {%- if settings.newsletter_enabled -%}
        <div class="newsletter">
          <h2>Stay informed</h2>
          <p>Project updates, practical solutions, and new Stories.</p>
          {% form 'customer', class: 'newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label for="FooterEmail">Email address</label>
            <div><input id="FooterEmail" type="email" name="contact[email]" autocomplete="email" required><button type="submit" aria-label="Subscribe">{% render 'rwn-icon', icon: 'arrow' %}</button></div>
            {%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">You are subscribed.</p>{%- endif -%}
            {{ form.errors | default_errors }}
          {% endform %}
        </div>
      {%- endif -%}
      <div class="social-links">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram | escape }}" rel="noopener noreferrer" target="_blank">Instagram</a>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook | escape }}" rel="noopener noreferrer" target="_blank">Facebook</a>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube | escape }}" rel="noopener noreferrer" target="_blank">YouTube</a>{%- endif -%}
        {%- if settings.social_x != blank -%}<a href="{{ settings.social_x | escape }}" rel="noopener noreferrer" target="_blank">X</a>{%- endif -%}
      </div>
    </div>
  </div>

  <div class="site-footer__legal">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.legal_organization_name | default: 'Real World Needs' | escape }}</p>
    <nav aria-label="Legal links">
      {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- else -%}{% render 'rwn-page-link', handle: 'privacy-policy', label: 'Privacy', class: 'footer-link' %}{%- endif -%}
      {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- else -%}{% render 'rwn-page-link', handle: 'terms-of-use', label: 'Terms', class: 'footer-link' %}{%- endif -%}
      {%- if shop.shipping_policy != blank -%}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{%- else -%}{% render 'rwn-page-link', handle: 'shipping-policy', label: 'Shipping', class: 'footer-link' %}{%- endif -%}
      {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">Returns</a>{%- else -%}{% render 'rwn-page-link', handle: 'return-policy', label: 'Returns', class: 'footer-link' %}{%- endif -%}
      {% render 'rwn-page-link', handle: 'accessibility', label: 'Accessibility', class: 'footer-link' %}
    </nav>
  </div>

  {%- if settings.charitable_solicitation_disclosure != blank -%}<div class="site-footer__disclosure">{{ settings.charitable_solicitation_disclosure | escape | newline_to_br }}</div>{%- endif -%}
</footer>

{% schema %}
{
  "name": "RWN footer",
  "settings": []
}
{% endschema %}
