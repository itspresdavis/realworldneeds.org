<section class="page-hero publication-hero">
  <div class="rwn-section__inner page-hero__inner">
    <div>
      <p class="section-kicker">Stories</p>
      <h1>{{ blog.title | default: 'Good Around the World' | escape }}</h1>
    </div>
    <p class="lead">Good work, useful solutions, project updates, and stories about people helping people.</p>
  </div>
</section>

<section class="rwn-section stories-index">
  <div class="rwn-section__inner">
    {%- if blog.articles_count > 0 -%}
      {%- paginate blog.articles by 12 -%}
        <div class="publication-grid publication-grid--index">
          {%- for article in blog.articles -%}
            {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
            {%- assign read_time = word_count | divided_by: 220 -%}
            {%- if read_time < 1 -%}{%- assign read_time = 1 -%}{%- endif -%}
            <article class="story-card {% if forloop.first and paginate.current_page == 1 %}story-card--feature{% endif %}">
              {%- if article.image -%}
                {%- assign article_image_alt = article.image.alt | default: article.title -%}
                <a class="article-media" href="{{ article.url }}">{{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: article_image_alt }}</a>
              {%- endif -%}
              <div class="story-card__body">
                <p class="section-kicker">{{ article.tags.first | default: 'Story' | escape }}</p>
                <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
                <p class="story-card__meta">{{ article.published_at | date: '%B %d, %Y' }} · {{ read_time }} min read</p>
                <p>{{ article.excerpt_or_content | strip_html | truncate: 170 | escape }}</p>
              </div>
            </article>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Stories pagination">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="publication-empty">
        <div class="publication-empty__image">
          <img src="{{ 'rwn-editorial-volunteers-boxes.jpg' | asset_url }}" width="340" height="242" alt="Volunteers organizing boxes at a community support center" loading="lazy">
        </div>
        <div>
          <p class="section-kicker">Editorial launch state</p>
          <h2>The first stories are not posted right now.</h2>
          <p>Articles added in Shopify will form the publication here, with categories such as Real World Needs, Good Around the World, Project Update, Completed Project, Community, Solutions, People, and Field Notes.</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RWN blog",
  "settings": []
}
{% endschema %}
