{%- assign article_count = blog.articles_count -%}

<section class="page-hero publication-hero" aria-labelledby="publication-title">
  <div class="rwn-section__inner page-hero__inner">
    <div>
      <p class="section-label">Stories</p>
      <h1 id="publication-title">Good Around the World</h1>
    </div>
    <div class="publication-hero__intro">
      <p class="lead">Clear reporting about useful ideas, good work, and what Real World Needs is learning as it grows.</p>
      <form class="publication-search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="article">
        <label for="StoriesSearch">Search Stories</label>
        <div><input id="StoriesSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search by topic"><button type="submit" aria-label="Search Stories">{% render 'rwn-icon', icon: 'search' %}</button></div>
      </form>
    </div>
  </div>
</section>

{%- if blog.all_tags.size > 0 -%}
  <nav class="publication-categories" aria-label="Story categories">
    <div class="rwn-section__inner">
      <a href="{{ blog.url }}"{% if current_tags == blank %} aria-current="page"{% endif %}>All Stories</a>
      {%- for tag in blog.all_tags limit: 10 -%}
        {{ tag | link_to_tag: tag }}
      {%- endfor -%}
    </div>
  </nav>
{%- endif -%}

<section class="rwn-section stories-index">
  <div class="rwn-section__inner">
    {%- if article_count > 0 -%}
      {%- paginate blog.articles by 13 -%}
        <div class="publication-grid publication-grid--index">
          {%- for article in blog.articles -%}
            {%- liquid
              assign word_count = article.content | strip_html | split: ' ' | size
              assign read_time = word_count | divided_by: 220
              if read_time < 1
                assign read_time = 1
              endif
              assign is_featured = false
              if forloop.first and paginate.current_page == 1
                assign is_featured = true
              endif
            -%}
            <article class="story-card{% if is_featured %} story-card--feature{% endif %}" data-reveal>
              {%- if article.image -%}
                {%- assign article_image_alt = article.image.alt | default: article.title -%}
                <a class="article-media" href="{{ article.url }}" aria-label="Read {{ article.title | escape }}">
                  {{ article.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 900px) 58vw, 100vw', alt: article_image_alt }}
                </a>
              {%- endif -%}
              <div class="story-card__body">
                <p class="section-label">{{ article.tags.first | default: 'Story' | escape }}</p>
                <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
                <p class="story-card__meta">
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
                  <span aria-hidden="true">|</span>
                  <span>{{ read_time }} min read</span>
                </p>
                {%- if is_featured -%}<p>{{ article.excerpt_or_content | strip_html | truncate: 190 | escape }}</p>{%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Stories pagination">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="publication-empty" data-reveal>
        <figure class="publication-empty__image">
          <img src="{{ 'rwn-editorial-lagos-food-bank.jpg' | asset_url }}" width="2400" height="1600" alt="Lagos Food Bank Initiative volunteers carrying food boxes in Lagos, Nigeria" loading="lazy">
          <figcaption>Lagos Food Bank Initiative volunteers in Nigeria. Editorial photograph by Lagos Food Bank Initiative via Pexels. This is not Real World Needs work.</figcaption>
        </figure>
        <div>
          <p class="section-label">The publication</p>
          <h2>The first edition is being prepared.</h2>
          <p>Stories will cover practical solutions, community work, project updates, and good news that deserves a closer look. Nothing will be published simply to fill the page.</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RWN blog",
  "settings": []
}
{% endschema %}
