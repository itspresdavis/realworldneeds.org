{%- liquid
  assign supporter_shop = collections['supporter-shop']
  assign shop_url = routes.all_products_collection_url
  if supporter_shop != blank
    assign shop_url = supporter_shop.url
  endif
-%}

<section class="rwn-section cart-page" aria-labelledby="cart-title">
  <div class="rwn-section__inner">
    <div class="cart-page__heading">
      <div><p class="section-label">Supporter Shop</p><h1 id="cart-title">Your cart</h1></div>
      {%- if cart.item_count > 0 -%}<p>{{ cart.item_count }} item{% unless cart.item_count == 1 %}s{% endunless %}</p>{%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-form">
        <div class="cart-lines">
          {%- for item in cart.items -%}
            <article class="cart-line">
              {%- if item.image -%}
                <a class="cart-line__media" href="{{ item.url }}">{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 240, 320', alt: item.product.title }}</a>
              {%- endif -%}
              <div class="cart-line__details">
                <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                {%- unless item.product.has_only_default_variant -%}<p>{{ item.variant.title | escape }}</p>{%- endunless -%}
                {%- for property in item.properties -%}
                  {%- assign first_character = property.first | slice: 0 -%}
                  {%- unless property.last == blank or first_character == '_' -%}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{%- endunless -%}
                {%- endfor -%}
                <a class="cart-line__remove" href="{{ item.url_to_remove }}">Remove</a>
              </div>
              <div class="cart-line__controls">
                <div class="field"><label for="updates_{{ item.key }}">Quantity</label><input id="updates_{{ item.key }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}" inputmode="numeric"></div>
                <p class="price">{{ item.final_line_price | money }}</p>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <aside class="cart-summary" aria-label="Order summary">
          <div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}<div><span>{{ discount.title | escape }}</span><strong>-{{ discount.total_allocated_amount | money }}</strong></div>{%- endfor -%}
          {%- endif -%}
          <p>Shipping and taxes are calculated at checkout.</p>
          <button class="button button--secondary" type="submit" name="update">Update cart</button>
          <button class="button button--primary" type="submit" name="checkout">Secure checkout</button>
          <a class="text-link" href="{{ shop_url }}">Continue shopping</a>
        </aside>
      </form>
    {%- else -%}
      <div class="shop-empty">
        <div><h2>Your cart is empty.</h2><p>Supporter merchandise can be added here when products are published.</p></div>
        <a class="button button--secondary" href="{{ shop_url }}">Browse the shop</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RWN cart",
  "settings": []
}
{% endschema %}
