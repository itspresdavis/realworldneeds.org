<section class="rwn-section rwn-section--white">
  <div class="rwn-section__inner">
    <p class="section-kicker">Cart</p>
    <h1>Your cart</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="form-grid">
        <div class="resource-list">
          {%- for item in cart.items -%}
            <article class="policy-card">
              <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
              <p class="muted">{{ item.variant.title | escape }}</p>
              <div class="field">
                <label for="updates_{{ item.key }}">Quantity</label>
                <input id="updates_{{ item.key }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}">
              </div>
              <p class="price">{{ item.final_line_price | money }}</p>
            </article>
          {%- endfor -%}
        </div>
        <p class="price">Subtotal {{ cart.total_price | money }}</p>
        <div class="action-row">
          <button class="button button--secondary" type="submit" name="update">Update cart</button>
          <button class="button button--primary" type="submit" name="checkout">Checkout</button>
        </div>
      </form>
    {%- else -%}
      <div class="empty-state">
        <h2>Your cart is empty.</h2>
        <p>Supporter merchandise appears here after products are published in Shopify.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RWN cart",
  "settings": []
}
{% endschema %}
