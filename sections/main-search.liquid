<section class="page-hero search-hero" aria-labelledby="search-title">
  <div class="rwn-section__inner page-hero__inner">
    <div><p class="section-label">Search</p><h1 id="search-title">Find something useful.</h1></div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <label for="SearchInput">Search Real World Needs</label>
      <div><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Projects, Stories, programs, products"><button type="submit" aria-label="Search">{% render 'rwn-icon', icon: 'search' %}</button></div>
    </form>
  </div>
</section>

<section class="rwn-section search-results">
  <div class="rwn-section__inner">
    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <div class="section-heading-row"><div><p class="section-label">Results</p><h2>{{ search.results_count }} result{% unless search.results_count == 1 %}s{% endunless %} for “{{ search.terms | escape }}”</h2></div></div>
        {%- paginate search.results by 12 -%}
          <div class="search-result-list">
            {%- for item in search.results -%}
              {%- assign result_image = item.featured_image | default: item.image -%}
              <article class="search-result">
                {%- if result_image != blank -%}<a class="search-result__media" href="{{ item.url }}">{{ result_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240, 360, 480, 600', alt: item.title }}</a>{%- endif -%}
                <div><p class="section-label">{{ item.object_type | default: 'Page' | replace: '_', ' ' | capitalize }}</p><h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3><p>{{ item.content | strip_html | truncate: 170 | escape }}</p><a class="text-link text-link--arrow" href="{{ item.url }}">Open {{ item.object_type | default: 'page' | replace: '_', ' ' }} {% render 'rwn-icon', icon: 'arrow' %}</a></div>
              </article>
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Search pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="record-zero"><div><p class="section-label">No results</p><h2>Nothing matched “{{ search.terms | escape }}.”</h2></div><p>Try a shorter phrase, browse the homepage, or visit Stories when articles are available.</p></div>
      {%- endif -%}
    {%- else -%}
      <div class="record-zero"><div><h2>Start with a word or phrase.</h2></div><p>Search across public pages, products, projects, and Stories.</p></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RWN search",
  "settings": []
}
{% endschema %}
