<section class="page-hero">
  <div class="rwn-section__inner page-hero__inner">
    <div>
      <p class="section-kicker">Page not found</p>
      <h1>This page is not available.</h1>
    </div>
    <p class="lead">The link may have changed, or the page may not be public right now. You can keep exploring from here.</p>
  </div>
</section>

<section class="rwn-section">
  <div class="rwn-section__inner">
    {%- assign how_url = routes.root_url | append: '#how-it-works' -%}
    {%- if pages['how-it-works'] != blank -%}{%- assign how_url = pages['how-it-works'].url -%}{%- endif -%}
    {%- assign needs_url = routes.root_url | append: '#needs' -%}
    {%- if pages['needs'] != blank -%}{%- assign needs_url = pages['needs'].url -%}{%- endif -%}
    {%- assign transparency_url = routes.root_url | append: '#transparency' -%}
    {%- if pages['transparency'] != blank -%}{%- assign transparency_url = pages['transparency'].url -%}{%- endif -%}
    <div class="ways-grid">
      <a href="{{ routes.root_url }}"><span>Go home</span><p>Return to the beginning of the Real World Needs story.</p></a>
      <a href="{{ how_url }}"><span>How It Works</span><p>See how needs move from review to action to reporting.</p></a>
      <a href="{{ needs_url }}"><span>Needs</span><p>View public needs when projects are published.</p></a>
      <a href="{{ transparency_url }}"><span>Transparency</span><p>Read the standard for project records and public reporting.</p></a>
      {%- if settings.stories_enabled and blogs['stories'] != blank -%}<a href="{{ blogs['stories'].url }}"><span>Stories</span><p>Read updates and editorial stories when they are published.</p></a>{%- endif -%}
      {%- if settings.merchandise_enabled -%}
        {%- assign shop_collection = collections['supporter-shop'] -%}
        {%- assign shop_url = routes.all_products_collection_url -%}
        {%- if shop_collection != blank -%}{%- assign shop_url = shop_collection.url -%}{%- endif -%}
        <a href="{{ shop_url }}"><span>Shop</span><p>Visit the Shopify supporter shop.</p></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RWN 404",
  "settings": []
}
{% endschema %}
