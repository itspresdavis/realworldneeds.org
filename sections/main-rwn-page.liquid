{%- liquid
  assign role = section.settings.page_role
  assign donation_ready = false
  if settings.donations_enabled and settings.donation_url != blank
    assign donation_ready = true
  endif
  assign monthly_donation_ready = false
  if settings.donations_enabled and settings.monthly_donation_url != blank
    assign monthly_donation_ready = true
  endif
  assign role_title = page.title | default: section.settings.fallback_title
-%}

<section class="page-hero">
  <div class="rwn-section__inner page-hero__inner">
    <div>
      <p class="section-kicker">{{ section.settings.kicker | escape }}</p>
      <h1>{{ role_title | escape }}</h1>
    </div>
    {%- if page.content != blank -%}
      <div class="lead rte">{{ page.content }}</div>
    {%- else -%}
      <p class="lead">{{ section.settings.fallback_intro | escape }}</p>
    {%- endif -%}
  </div>
</section>

{%- case role -%}
  {%- when 'needs' -%}
    <section class="rwn-section needs-section">
      <div class="rwn-section__inner">
        <div class="section-heading-row">
          <div>
            <p class="section-kicker">Project Records</p>
            <h2>Needs are published only when they can be described responsibly.</h2>
            <p class="lead">A public need needs enough detail to explain the situation, the responsible party, the verification notes, the support path, and what happens next.</p>
          </div>
        </div>

        {%- assign project_count = 0 -%}
        {%- if settings.projects_enabled and metaobjects.rwn_project.values != blank -%}
          <div class="need-grid">
            {%- for project in metaobjects.rwn_project.values -%}
              {%- assign project_title = project.title.value | default: project.title -%}
              {%- assign project_summary = project.short_summary.value | default: project.short_summary -%}
              {%- assign project_status = project.status.value | default: project.status -%}
              {%- assign project_location = project.location.value | default: project.location -%}
              {%- if project_title != blank -%}
                {%- assign project_count = project_count | plus: 1 -%}
                <article class="need-card">
                  <div class="need-card__meta">
                    <span class="status-label">{{ project_status | default: 'Being reviewed' | escape }}</span>
                    {%- if project_location != blank -%}<span>{{ project_location | escape }}</span>{%- endif -%}
                  </div>
                  <h3>{{ project_title | escape }}</h3>
                  {%- if project_summary != blank -%}<p>{{ project_summary | strip_html | truncate: 170 | escape }}</p>{%- endif -%}
                  {%- if project.system.url != blank -%}<a class="text-link" href="{{ project.system.url }}">View Project</a>{%- endif -%}
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if project_count == 0 -%}
          <div class="launch-state">
            <p class="section-kicker">No public needs yet</p>
            <h3>The needs board is waiting for the first reviewed project.</h3>
            <p>Published projects can show what is needed, who is responsible, whether RWN is acting directly or supporting a partner, and which actions are available.</p>
          </div>
        {%- endif -%}
      </div>
    </section>

  {%- when 'our-work', 'programs' -%}
    <section class="rwn-section work-map">
      <div class="rwn-section__inner">
        <p class="section-kicker">Current Focus</p>
        <h2>Starting small, with a structure built to grow.</h2>
        <div class="work-focus">
          <article>
            <span>Current focus</span>
            <h3>Clothing</h3>
            <p>Real World Needs is beginning with donated clothing because it is practical, visible, and immediately useful when handled with care.</p>
            {% render 'rwn-page-link', handle: 'give-clothing', label: 'Give Clothing' %}
          </article>
          <article>
            <span>Being developed</span>
            <h3>Projects and needs</h3>
            <p>The project system supports direct RWN work and carefully selected partner efforts.</p>
            {% render 'rwn-page-link', handle: 'needs', label: 'View Needs' %}
          </article>
        </div>

        <div class="program-grid" aria-label="Possible areas of work">
          <article><span>Future area</span><h3>Food</h3><p>Food access work requires real partners, logistics, and reporting.</p></article>
          <article><span>Future area</span><h3>Clean Water</h3><p>Water-related projects need responsible operators and verifiable outcomes.</p></article>
          <article><span>Future area</span><h3>Housing</h3><p>Housing and household support require careful boundaries, privacy, and documentation.</p></article>
          <article><span>Future area</span><h3>Emergency Needs</h3><p>Emergency assistance has to move quickly without losing accountability.</p></article>
          <article><span>Future area</span><h3>Disaster Response</h3><p>Disaster support can happen through trusted partners or direct projects when capacity exists.</p></article>
          <article><span>Future area</span><h3>Community Projects</h3><p>Local improvements can become clear, trackable needs with visible outcomes.</p></article>
        </div>
      </div>
    </section>

  {%- when 'how-it-works' -%}
    <section class="rwn-section process-section">
      <div class="rwn-section__inner">
        <p class="section-kicker">The Model</p>
        <h2>Identify. Verify. Mobilize. Act. Report.</h2>
        <ol class="process-timeline process-timeline--page">
          <li><span>Identify</span><h3>Start with a real situation.</h3><p>A project begins when a need can be described plainly enough for people to understand what is happening.</p></li>
          <li><span>Verify</span><h3>Review before presenting.</h3><p>Real World Needs records what is known, what is uncertain, who is responsible, and what support could reasonably do.</p></li>
          <li><span>Mobilize</span><h3>Gather useful support.</h3><p>Support may be donated goods, volunteers, funding, professional services, transportation, or a qualified charitable partner.</p></li>
          <li><span>Act</span><h3>Do the useful thing.</h3><p>The response is carried out directly or through the appropriate organization.</p></li>
          <li><span>Report</span><h3>Show the record.</h3><p>Published projects can show progress, expenses where appropriate, final results, and what came next.</p></li>
        </ol>
      </div>
    </section>

  {%- when 'transparency' -%}
    <section class="rwn-section transparency-page">
      <div class="rwn-section__inner">
        <p class="section-kicker">Standard</p>
        <h2>Transparency begins before the first project.</h2>
        <div class="transparency-ledger transparency-ledger--page">
          <span>Original need</span>
          <span>Responsible organization</span>
          <span>Support received</span>
          <span>Project expenses</span>
          <span>Receipts where appropriate</span>
          <span>Updates</span>
          <span>Photos and media</span>
          <span>Final outcome</span>
          <span>What remains unfinished</span>
        </div>

        <div class="resource-list">
          <article class="policy-card"><h3>Active Projects</h3><p>No active public projects are posted right now.</p></article>
          <article class="policy-card"><h3>Completed Projects</h3><p>No completed projects are posted right now.</p></article>
          <article class="policy-card"><h3>Project Spending</h3><p>Expense records can include date, project, vendor, description, amount, category, public note, and receipt.</p></article>
          <article class="policy-card"><h3>Financial Reports</h3><p>No financial reports are posted right now. Reports belong here after they exist and are approved.</p></article>
          <article class="policy-card"><h3>Government Filings</h3><p>Real World Needs has not published an annual filing on this site.</p></article>
          <article class="policy-card"><h3>Audits</h3><p>No audit documents are posted right now.</p></article>
          <article class="policy-card"><h3>Policies</h3><p>Public policies belong here after review, in plain language.</p></article>
          <article class="policy-card"><h3>Governance</h3><p>Board, leadership, and governance materials belong here once approved.</p></article>
          <article class="policy-card"><h3>Partner Verification</h3><p>Partner projects identify the responsible organization and verification approach.</p></article>
        </div>
      </div>
    </section>

  {%- when 'financials' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <div class="launch-state">
          <p class="section-kicker">Financial reports</p>
          <h2>No financial reports are posted right now.</h2>
          <p>Annual reports, government filings, audits, financial statements, and downloadable public documents belong here after they exist and are approved for release.</p>
        </div>
      </div>
    </section>

  {%- when 'donate' -%}
    <section class="rwn-section donate-page">
      <div class="rwn-section__inner">
        <p class="section-kicker">Donation Readiness</p>
        <h2>Giving must be clear before anyone gives.</h2>
        <div class="policy-grid">
          <article class="policy-card"><h3>General giving</h3><p>A general donation button appears only after the donation URL is configured.</p></article>
          <article class="policy-card"><h3>Monthly giving</h3><p>A monthly giving button appears only when a separate monthly donation URL exists.</p></article>
          <article class="policy-card"><h3>Project giving</h3><p>Project donation buttons are controlled by each published project and its status.</p></article>
          <article class="policy-card"><h3>Receipts</h3><p>{{ settings.donation_receipt_information | default: 'Donation receipt information will be added after the processor is configured.' | escape }}</p></article>
        </div>

        {%- if settings.tax_deductible_language_enabled and settings.tax_exempt_status_confirmed and settings.nonprofit_status_text != blank -%}
          <div class="trust-note"><p>{{ settings.nonprofit_status_text | escape }}</p></div>
        {%- else -%}
          <div class="trust-note"><p>This site is not displaying tax deductible language. That language appears only after status and required disclosures are confirmed.</p></div>
        {%- endif -%}

        <div class="action-row">
          {%- if donation_ready -%}<a class="button button--primary" href="{{ settings.donation_url | escape }}">Continue to Donation Processor</a>{%- endif -%}
          {%- if monthly_donation_ready -%}<a class="button button--secondary" href="{{ settings.monthly_donation_url | escape }}">Monthly Giving</a>{%- endif -%}
        </div>

        {%- unless donation_ready or monthly_donation_ready -%}
          <div class="launch-state"><h3>Online donations are not enabled right now.</h3><p>Donation buttons appear after the donation destination is configured, tested, and reviewed.</p></div>
        {%- endunless -%}
      </div>
    </section>

  {%- when 'give-clothing' -%}
    <section class="rwn-section clothing-page">
      <div class="rwn-section__inner clothing-page__grid">
        <div>
          <p class="section-kicker">Standard</p>
          <h2>Donate what you would feel comfortable giving to someone you care about.</h2>
          <p class="lead">The first clothing program is built around quality, organization, dignity, and clear records.</p>
        </div>
        <div class="clothing-page__image">
          <img src="{{ 'rwn-editorial-clothing-room.jpg' | asset_url }}" width="340" height="231" alt="People working in a room with clothing racks" loading="lazy">
        </div>
      </div>

      <div class="rwn-section__inner donation-guides">
        <article>
          <h3>What to Donate</h3>
          <ul>
            <li>Clean clothing</li>
            <li>Children's clothing</li>
            <li>Adult clothing</li>
            <li>Coats</li>
            <li>Shoes in usable condition</li>
            <li>Work clothing</li>
            <li>Interview clothing</li>
            <li>New socks</li>
            <li>New underwear</li>
          </ul>
        </article>
        <article>
          <h3>What Not to Donate</h3>
          <ul>
            <li>Wet clothing</li>
            <li>Moldy clothing</li>
            <li>Heavily damaged clothing</li>
            <li>Unsafe items</li>
            <li>Items someone cannot reasonably use</li>
          </ul>
        </article>
      </div>

      <div class="rwn-section__inner clothing-flow clothing-flow--page">
        <article><span>How clothing is used</span><p>Donations are sorted and moved with a plan, not passed around without purpose.</p></article>
        <article><span>How sorting works</span><p>Volunteers inspect condition, organize by category and size, and remove items that are not usable.</p></article>
        <article><span>How distribution works</span><p>Distribution preserves dignity and choice whenever possible.</p></article>
        <article><span>Host a drive</span><p>Drive information is published only when collection rules, dates, contacts, and logistics are ready.</p></article>
      </div>

      <div class="rwn-section__inner">
        <div class="launch-state"><h3>No public clothing locations or drives are listed right now.</h3><p>Approved locations and upcoming drives belong here once dates, contacts, and logistics are confirmed.</p></div>
      </div>
    </section>

  {%- when 'volunteer' -%}
    <section class="rwn-section volunteer-page">
      <div class="rwn-section__inner">
        <p class="section-kicker">Volunteer</p>
        <h2>Volunteer work has to match real capacity.</h2>
        <div class="program-grid">
          <article><span>Potential opportunity</span><h3>Clothing sorting</h3><p>Inspect and organize donated clothing when sorting sessions are scheduled.</p></article>
          <article><span>Potential opportunity</span><h3>Distribution events</h3><p>Help make clothing easy to browse and receive with dignity.</p></article>
          <article><span>Potential opportunity</span><h3>Donation drives</h3><p>Support collection logistics for schools, businesses, churches, and community groups.</p></article>
          <article><span>Potential opportunity</span><h3>Transportation</h3><p>Move donated goods only when routes, safety, and responsibility are clear.</p></article>
          <article><span>Potential opportunity</span><h3>Photography</h3><p>Document events respectfully and only with appropriate permissions.</p></article>
          <article><span>Potential opportunity</span><h3>Professional skills</h3><p>Support projects with planning, writing, logistics, design, finance, or operations.</p></article>
        </div>

        {%- if settings.volunteer_applications_enabled -%}
          {% form 'contact', class: 'form-grid rwn-form' %}
            {%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">Your message was sent.</p>{%- endif -%}
            {{ form.errors | default_errors }}
            <input type="hidden" name="contact[subject]" value="Volunteer interest">
            <div class="field"><label for="VolunteerName">Name</label><input id="VolunteerName" name="contact[name]" autocomplete="name" required></div>
            <div class="field"><label for="VolunteerEmail">Email</label><input id="VolunteerEmail" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="field"><label for="VolunteerInterest">How would you like to help?</label><textarea id="VolunteerInterest" name="contact[body]" required></textarea></div>
            <button class="button button--primary" type="submit">Send Volunteer Interest</button>
          {% endform %}
        {%- else -%}
          <div class="launch-state"><h3>Volunteer applications are not open right now.</h3><p>This page updates when Real World Needs is ready to receive volunteer interest.</p></div>
        {%- endif -%}
      </div>
    </section>

  {%- when 'get-help' -%}
    <section class="rwn-section get-help-page">
      <div class="rwn-section__inner">
        <p class="section-kicker">Get Help</p>
        <h2>Assistance has to be described honestly and respectfully.</h2>
        <p class="lead">Real World Needs does not imply help is available before a program is open and able to respond.</p>

        {%- if settings.get_help_requests_enabled -%}
          {% form 'contact', class: 'form-grid rwn-form' %}
            {%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">Your message was sent.</p>{%- endif -%}
            {{ form.errors | default_errors }}
            <input type="hidden" name="contact[subject]" value="Help request information">
            <div class="field"><label for="HelpName">Name</label><input id="HelpName" name="contact[name]" autocomplete="name" required></div>
            <div class="field"><label for="HelpEmail">Email</label><input id="HelpEmail" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="field"><label for="HelpMessage">What kind of information are you looking for?</label><textarea id="HelpMessage" name="contact[body]" required></textarea></div>
            <button class="button button--primary" type="submit">Send Message</button>
          {% endform %}
        {%- else -%}
          <div class="launch-state"><h3>No public help intake is currently open.</h3><p>Available services, eligibility information, and contact instructions belong here when a program is ready. Please do not submit private medical, financial, or safety information through a general contact form.</p></div>
        {%- endif -%}
      </div>
    </section>

  {%- when 'impact' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <div class="launch-state">
          <p class="section-kicker">Impact</p>
          <h2>Impact reporting begins after real work can be measured.</h2>
          <p>This page is prepared for project outcomes, completed work, and public reports. It will not display counters, percentages, or totals until there is verified information to publish.</p>
        </div>
      </div>
    </section>

  {%- when 'about' -%}
    <section class="rwn-section about-page">
      <div class="rwn-section__inner about-page__grid">
        <article><span>Why Real World Needs Exists</span><h2>Real needs should lead to real action.</h2><p>People want to help, but the path from concern to useful action is often unclear. Real World Needs exists to make that path easier to understand.</p></article>
        <article><span>The Mission</span><h3>Identify genuine needs, organize practical help, and show what happened.</h3><p>The mission is intentionally plain. If the need is real, the action must be useful, and the record must be clear.</p></article>
        <article><span>The Long Term Vision</span><h3>A platform for many kinds of human need.</h3><p>Clothing is the starting point. Over time, the same disciplined model can support food, water, housing, emergency needs, disaster response, and community projects.</p></article>
        <article><span>How RWN Thinks About Help</span><h3>Practical before performative.</h3><p>Good work has to make sense to the person giving help and respect the person receiving it.</p></article>
        <article><span>Why Transparency Matters</span><h3>Trust is built in the record.</h3><p>Projects can show the original need, the response, the spending where appropriate, and the outcome.</p></article>
        <article><span>Starting Small</span><h3>Begin with clothing. Learn in public. Grow carefully.</h3><p>The organization is new, and the website is designed to be honest about that while preparing for real work ahead.</p></article>
      </div>
      <div class="rwn-section__inner">
        <div class="policy-grid">
          <article class="policy-card"><h3>Leadership</h3><p>Leadership information belongs here after names, roles, bios, and permissions are ready.</p></article>
          <article class="policy-card"><h3>Board</h3><p>Board information belongs here after governance records and public approvals are ready.</p></article>
          <article class="policy-card"><h3>The Future</h3><p>The site is built to grow through real projects, public reports, stories, merchandise, and volunteer opportunities.</p></article>
        </div>
      </div>
    </section>

  {%- when 'governance', 'leadership-board' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <div class="policy-grid">
          <article class="policy-card"><h3>Governance Documents</h3><p>No public governance documents are posted right now.</p></article>
          <article class="policy-card"><h3>Board Information</h3><p>Board members are listed only after names, roles, and permissions are confirmed.</p></article>
          <article class="policy-card"><h3>Leadership Compensation</h3><p>Compensation information belongs here after the organization reviews what belongs in public.</p></article>
          <article class="policy-card"><h3>Policies</h3><p>Conflict of interest, privacy, volunteer, partner, and financial policies can be added as documents or page content.</p></article>
        </div>
      </div>
    </section>

  {%- when 'contact' -%}
    <section class="rwn-section contact-page">
      <div class="rwn-section__inner contact-page__grid">
        <div>
          <p class="section-kicker">Contact</p>
          <h2>Reach Real World Needs.</h2>
          <div class="contact-methods">
            {%- if settings.contact_email != blank -%}<a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a>{%- endif -%}
            {%- if settings.public_phone != blank -%}<a href="tel:{{ settings.public_phone | escape }}">{{ settings.public_phone | escape }}</a>{%- endif -%}
            {%- if settings.public_address != blank -%}<p>{{ settings.public_address | escape | newline_to_br }}</p>{%- endif -%}
          </div>
        </div>
        {% form 'contact', class: 'form-grid rwn-form' %}
          {%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">Your message was sent.</p>{%- endif -%}
          {{ form.errors | default_errors }}
          <div class="field"><label for="ContactName">Name</label><input id="ContactName" name="contact[name]" autocomplete="name" required></div>
          <div class="field"><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required></div>
          <div class="field"><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" required></textarea></div>
          <button class="button button--primary" type="submit">Send Message</button>
        {% endform %}
      </div>
    </section>

  {%- when 'faq' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner faq-list">
        <details open><summary>Is Real World Needs active yet?</summary><p>Real World Needs is new. The first intended focus is donated clothing, and public projects publish only after they have enough information to share responsibly.</p></details>
        <details><summary>Can I donate money today?</summary><p>Donation buttons appear only when a real donation destination has been configured and reviewed.</p></details>
        <details><summary>Can I donate clothing today?</summary><p>Approved collection locations and drive dates will be published on the Give Clothing page when they are available.</p></details>
        <details><summary>Where will project reports appear?</summary><p>Project records, updates, expenses where appropriate, and final outcomes live on project and transparency pages.</p></details>
      </div>
    </section>

  {%- when 'legal', 'privacy-policy', 'terms-of-use', 'donation-policy', 'donation-refund-policy', 'shipping-policy', 'return-policy', 'accessibility' -%}
    <section class="rwn-section legal-page">
      <div class="rwn-section__inner">
        <p class="section-kicker">Review Required</p>
        <h2>Public policy language must match the real organization.</h2>
        <div class="policy-grid">
          <article class="policy-card"><h3>Legal status</h3><p>{{ settings.organization_status_text | default: 'Organization status has not been added.' | escape }}</p></article>
          <article class="policy-card"><h3>Federal tax status</h3><p>{{ settings.federal_tax_status_text | default: 'Federal tax status has not been added.' | escape }}</p></article>
          <article class="policy-card"><h3>Tax deductibility</h3><p>{{ settings.tax_deductibility_status_text | default: 'Tax deductibility language has not been added.' | escape }}</p></article>
          <article class="policy-card"><h3>Charitable solicitation</h3><p>{{ settings.charitable_solicitation_status_text | default: 'Charitable solicitation disclosure language has not been added.' | escape }}</p></article>
          <article class="policy-card"><h3>Donation processor</h3><p>{{ settings.donation_processor_name | default: 'Donation processor information has not been added.' | escape }}</p></article>
          <article class="policy-card"><h3>Merchandise policies</h3><p>Shipping and return language must match Shopify, Printify, and the actual fulfillment settings.</p></article>
        </div>
      </div>
    </section>

  {%- else -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <div class="policy-grid">
          <article class="policy-card"><h3>Built to grow</h3><p>This page can be managed in Shopify and extended as Real World Needs publishes approved information.</p></article>
          <article class="policy-card"><h3>Truth first</h3><p>Do not add numbers, partners, testimonials, locations, or claims until they are real and approved.</p></article>
          <article class="policy-card"><h3>Actions stay routed</h3><p>Buttons and calls to action appear only when their destination is configured.</p></article>
        </div>
      </div>
    </section>
{%- endcase -%}

{% schema %}
{
  "name": "RWN page",
  "settings": [
    {
      "type": "select",
      "id": "page_role",
      "label": "Page role",
      "default": "generic",
      "options": [
        { "value": "generic", "label": "Generic" },
        { "value": "needs", "label": "Needs" },
        { "value": "about", "label": "About" },
        { "value": "our-work", "label": "Our Work" },
        { "value": "programs", "label": "Programs" },
        { "value": "how-it-works", "label": "How It Works" },
        { "value": "impact", "label": "Impact" },
        { "value": "transparency", "label": "Transparency" },
        { "value": "financials", "label": "Financials" },
        { "value": "donate", "label": "Donate" },
        { "value": "give-clothing", "label": "Give Clothing" },
        { "value": "volunteer", "label": "Volunteer" },
        { "value": "get-help", "label": "Get Help" },
        { "value": "contact", "label": "Contact" },
        { "value": "faq", "label": "FAQ" },
        { "value": "governance", "label": "Governance" },
        { "value": "leadership-board", "label": "Leadership and Board" },
        { "value": "legal", "label": "Legal" },
        { "value": "privacy-policy", "label": "Privacy Policy" },
        { "value": "terms-of-use", "label": "Terms of Use" },
        { "value": "donation-policy", "label": "Donation Policy" },
        { "value": "donation-refund-policy", "label": "Donation Refund Policy" },
        { "value": "shipping-policy", "label": "Shipping Policy" },
        { "value": "return-policy", "label": "Merchandise Return Policy" },
        { "value": "accessibility", "label": "Accessibility" }
      ]
