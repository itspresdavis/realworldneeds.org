{%- liquid
  assign role = section.settings.page_role
  assign donation_ready = false
  if settings.donations_enabled and settings.donation_url != blank
    assign donation_ready = true
  endif
  assign role_title = page.title | default: section.settings.fallback_title
-%}

<section class="rwn-section rwn-section--white">
  <div class="rwn-section__inner">
    <p class="section-kicker">{{ section.settings.kicker | escape }}</p>
    <h1>{{ role_title | escape }}</h1>
    {%- if page.content != blank -%}
      <div class="lead">{{ page.content }}</div>
    {%- else -%}
      <p class="lead">{{ section.settings.fallback_intro | escape }}</p>
    {%- endif -%}
  </div>
</section>

{%- case role -%}
  {%- when 'needs' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>Needs are published only when there is enough information to do it responsibly.</h2>
        {%- assign project_count = 0 -%}
        {%- if settings.projects_enabled and metaobjects.rwn_project.values != blank -%}
          <div class="need-grid">
            {%- for project in metaobjects.rwn_project.values -%}
              {%- assign project_title = project.title.value | default: project.title -%}
              {%- assign project_summary = project.short_summary.value | default: project.short_summary -%}
              {%- assign project_status = project.status.value | default: project.status -%}
              {%- if project_title != blank -%}
                {%- assign project_count = project_count | plus: 1 -%}
                <article class="need-card">
                  <span class="status-label">{{ project_status | default: 'Being verified' | escape }}</span>
                  <h3>{{ project_title | escape }}</h3>
                  {%- if project_summary != blank -%}<p>{{ project_summary | strip_html | escape }}</p>{%- endif -%}
                  {%- if project.system.url != blank -%}<a class="text-link" href="{{ project.system.url }}">View need</a>{%- endif -%}
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if project_count == 0 -%}
          <div class="empty-state">
            <h3>No active projects are currently published.</h3>
            <p>Our first projects will appear here as they launch. Each published need should explain what is needed, who is responsible, how support is used, and what happens next.</p>
          </div>
        {%- endif -%}
      </div>
    </section>

  {%- when 'how-it-works' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>The model is built around plain information.</h2>
        <ol class="step-list">
          <li><div><h3>Identify</h3><p>Find a need that can be understood and acted on.</p></div></li>
          <li><div><h3>Verify</h3><p>Record what is known, what is uncertain, and who is responsible.</p></div></li>
          <li><div><h3>Mobilize</h3><p>Bring together funding, donated goods, volunteers, partners, or direct program support.</p></div></li>
          <li><div><h3>Act</h3><p>Use support for the actual need and keep the process documented.</p></div></li>
          <li><div><h3>Report</h3><p>Publish updates and final results when information is ready to share.</p></div></li>
        </ol>
      </div>
    </section>

  {%- when 'transparency' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>Transparency starts before the first report exists.</h2>
        <div class="policy-grid">
          <article class="policy-card"><h3>Project status</h3><p>Every published project should show where it stands and what comes next.</p></article>
          <article class="policy-card"><h3>Project expenses</h3><p>Expenses can be listed with dates, vendors, amounts, categories, public notes, and receipt links where appropriate.</p></article>
          <article class="policy-card"><h3>Financial reports</h3><p>Annual reports, filings, audits, and board information will appear when they exist and are approved for publication.</p></article>
          <article class="policy-card"><h3>Privacy boundaries</h3><p>Public reporting must not expose donor payment data, private beneficiary details, or private addresses without deliberate approval.</p></article>
          <article class="policy-card"><h3>Partner verification</h3><p>Partner projects should identify the responsible organization and how Real World Needs verified the work.</p></article>
          <article class="policy-card"><h3>Impact measurement</h3><p>Impact claims are shown only when real information has been reviewed.</p></article>
        </div>
      </div>
    </section>

  {%- when 'financials' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>Financial reports will be published here as they become available.</h2>
        <div class="empty-state">
          <h3>No financial filings or public reports are currently listed.</h3>
          <p>This page is ready for annual reports, government filings, audits, policies, and other public financial documents after review.</p>
        </div>
      </div>
    </section>

  {%- when 'donate' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>Giving options should be clear before anyone gives.</h2>
        <div class="policy-grid">
          <article class="policy-card"><h3>General giving</h3><p>Support the work where it is needed most after the donation processor is configured.</p></article>
          <article class="policy-card"><h3>Project specific giving</h3><p>Project donation buttons appear only when a published project has its own valid donation URL.</p></article>
          <article class="policy-card"><h3>Receipts</h3><p>{{ settings.donation_receipt_information | default: 'Donation receipt information will be added after the processor is configured.' | escape }}</p></article>
        </div>
        {%- if settings.tax_deductible_language_enabled and settings.tax_exempt_status_confirmed -%}
          <div class="empty-state"><p>{{ settings.nonprofit_status_text | escape }}</p></div>
        {%- else -%}
          <div class="empty-state"><p>Tax deductible language is not enabled. This site will not claim tax deductibility until an administrator confirms the correct status and disclosures.</p></div>
        {%- endif -%}
        {%- if donation_ready -%}
          <div class="action-row"><a class="button button--primary" href="{{ settings.donation_url | escape }}">Continue to donation processor</a></div>
        {%- else -%}
          <div class="empty-state"><h3>Online donations are not enabled yet.</h3><p>A donation button will appear after the donation URL and launch settings are configured.</p></div>
        {%- endif -%}
      </div>
    </section>

  {%- when 'give-clothing' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>Clothing support begins with quality and dignity.</h2>
        <div class="status-strip">
          <div><strong>Quality items</strong><p>Bring clean clothing that someone can use with confidence.</p></div>
          <div><strong>Sorting</strong><p>Volunteers organize items by type, size, condition, and season.</p></div>
          <div><strong>Distribution</strong><p>People should be able to choose useful clothing with dignity.</p></div>
          <div><strong>Documentation</strong><p>Results are published when real events and counts exist.</p></div>
        </div>
        <div class="empty-state">
          <h3>No public clothing events or collection locations are currently listed.</h3>
          <p>Locations and events will appear here after they are approved.</p>
        </div>
      </div>
    </section>

  {%- when 'volunteer' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>Volunteer opportunities will open when there is work ready for volunteers.</h2>
        {%- if settings.volunteer_applications_enabled -%}
          {% form 'contact', class: 'form-grid' %}
            {%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">Your message was sent.</p>{%- endif -%}
            {{ form.errors | default_errors }}
            <input type="hidden" name="contact[subject]" value="Volunteer interest">
            <div class="field"><label for="VolunteerName">Name</label><input id="VolunteerName" name="contact[name]" autocomplete="name" required></div>
            <div class="field"><label for="VolunteerEmail">Email</label><input id="VolunteerEmail" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="field"><label for="VolunteerMessage">How would you like to help?</label><textarea id="VolunteerMessage" name="contact[body]" required></textarea></div>
            <button class="button button--primary" type="submit">Send volunteer interest</button>
          {% endform %}
        {%- else -%}
          <div class="empty-state"><h3>Volunteer applications are not open yet.</h3><p>This page will update when Real World Needs is ready to receive volunteer interest.</p></div>
        {%- endif -%}
      </div>
    </section>

  {%- when 'get-help' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>Help information must be handled with care.</h2>
        {%- if settings.get_help_requests_enabled -%}
          {% form 'contact', class: 'form-grid' %}
            {%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">Your message was sent.</p>{%- endif -%}
            {{ form.errors | default_errors }}
            <input type="hidden" name="contact[subject]" value="Help request information">
            <div class="field"><label for="HelpName">Name</label><input id="HelpName" name="contact[name]" autocomplete="name" required></div>
            <div class="field"><label for="HelpEmail">Email</label><input id="HelpEmail" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="field"><label for="HelpMessage">What kind of information are you looking for?</label><textarea id="HelpMessage" name="contact[body]" required></textarea></div>
            <button class="button button--primary" type="submit">Send message</button>
          {% endform %}
        {%- else -%}
          <div class="empty-state"><h3>No public help intake is currently open.</h3><p>Real World Needs should not collect sensitive personal information until the process, privacy practices, and response capacity are ready.</p></div>
        {%- endif -%}
      </div>
    </section>

  {%- when 'contact' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>Contact Real World Needs.</h2>
        <div class="policy-grid">
          {%- if settings.contact_email != blank -%}<article class="policy-card"><h3>Email</h3><p><a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a></p></article>{%- endif -%}
          {%- if settings.public_phone != blank -%}<article class="policy-card"><h3>Phone</h3><p><a href="tel:{{ settings.public_phone | escape }}">{{ settings.public_phone | escape }}</a></p></article>{%- endif -%}
          {%- if settings.public_address != blank -%}<article class="policy-card"><h3>Mailing address</h3><p>{{ settings.public_address | escape | newline_to_br }}</p></article>{%- endif -%}
        </div>
        {% form 'contact', class: 'form-grid' %}
          {%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">Your message was sent.</p>{%- endif -%}
          {{ form.errors | default_errors }}
          <div class="field"><label for="ContactName">Name</label><input id="ContactName" name="contact[name]" autocomplete="name" required></div>
          <div class="field"><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required></div>
          <div class="field"><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" required></textarea></div>
          <button class="button button--primary" type="submit">Send message</button>
        {% endform %}
      </div>
    </section>

  {%- when 'legal', 'privacy-policy', 'terms-of-use', 'donation-policy', 'donation-refund-policy', 'shipping-policy', 'return-policy', 'accessibility' -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <h2>Starter language is editable and requires review.</h2>
        <div class="policy-grid">
          <article class="policy-card"><h3>No invented status</h3><p>This theme does not claim nonprofit, tax exempt, charitable registration, or tax deductible status unless settings are deliberately enabled.</p></article>
          <article class="policy-card"><h3>Administrator review</h3><p>Final policy language depends on actual formation status, donation processor, merchandise operations, data collection, and states where solicitations occur.</p></article>
          <article class="policy-card"><h3>Public disclosure area</h3><p>Use the legal settings to add required charitable solicitation disclosures and status language after review.</p></article>
        </div>
      </div>
    </section>

  {%- else -%}
    <section class="rwn-section">
      <div class="rwn-section__inner">
        <div class="policy-grid">
          <article class="policy-card"><h3>Built to grow</h3><p>This page can be edited in Shopify and extended with sections as Real World Needs publishes real information.</p></article>
          <article class="policy-card"><h3>Truth first</h3><p>Do not add numbers, partners, testimonials, locations, or claims until they are real and approved.</p></article>
          <article class="policy-card"><h3>Safe by default</h3><p>Links and actions are hidden until the destination or feature is configured.</p></article>
        </div>
      </div>
    </section>
{%- endcase -%}

{% schema %}
{
  "name": "RWN page",
  "settings": [
    {
      "type": "select",
      "id": "page_role",
      "label": "Page role",
      "default": "generic",
      "options": [
        { "value": "generic", "label": "Generic" },
        { "value": "needs", "label": "Needs" },
        { "value": "our-work", "label": "Our Work" },
        { "value": "programs", "label": "Programs" },
        { "value": "how-it-works", "label": "How It Works" },
        { "value": "impact", "label": "Impact" },
        { "value": "transparency", "label": "Transparency" },
        { "value": "financials", "label": "Financials" },
        { "value": "donate", "label": "Donate" },
        { "value": "give-clothing", "label": "Give Clothing" },
        { "value": "volunteer", "label": "Volunteer" },
        { "value": "get-help", "label": "Get Help" },
        { "value": "contact", "label": "Contact" },
        { "value": "faq", "label": "FAQ" },
        { "value": "governance", "label": "Governance" },
        { "value": "leadership-board", "label": "Leadership and Board" },
        { "value": "legal", "label": "Legal" },
        { "value": "privacy-policy", "label": "Privacy Policy" },
        { "value": "terms-of-use", "label": "Terms of Use" },
        { "value": "donation-policy", "label": "Donation Policy" },
        { "value": "donation-refund-policy", "label": "Donation Refund Policy" },
        { "value": "shipping-policy", "label": "Shipping Policy" },
        { "value": "return-policy", "label": "Merchandise Return Policy" },
        { "value": "accessibility", "label": "Accessibility" }
      ]
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Real World Needs"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Fallback title",
      "default": "Real World Needs"
    },
    {
      "type": "textarea",
      "id": "fallback_intro",
      "label": "Fallback intro",
      "default": "This page is ready for real information from Real World Needs. The theme does not add invented claims or unverified achievements."
    }
  ]
}
{% endschema %}
