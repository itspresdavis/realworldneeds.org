{%- liquid
  assign role = section.settings.page_role
  assign donation_ready = false
  if settings.donations_enabled and settings.donation_url != blank
    assign donation_ready = true
  endif
  assign monthly_donation_ready = false
  if settings.donations_enabled and settings.monthly_donation_url != blank
    assign monthly_donation_ready = true
  endif

  assign hero_title = page.title | default: section.settings.fallback_title
  assign hero_intro = section.settings.fallback_intro
  case role
    when 'needs'
      assign hero_title = 'Every need needs a clear record.'
      assign hero_intro = 'A public need should explain the situation, who is responsible, how support can help, and what happens next.'
    when 'our-work', 'programs'
      assign hero_title = 'Start with what can be done well.'
      assign hero_intro = 'Clothing is the first focus. Other areas of work will open only when the people, partners, and systems are ready.'
    when 'how-it-works'
      assign hero_title = 'From a real need to a public record.'
      assign hero_intro = 'Understand the situation. Bring together the right help. Do the work. Show the result.'
    when 'transparency'
      assign hero_title = 'Nothing hidden by design.'
      assign hero_intro = 'Every public project should carry its own record: the need, the plan, who is responsible, what came in, what was spent, and what happened next.'
    when 'give-clothing'
      assign hero_title = 'Useful clothing should not sit unused.'
      assign hero_intro = 'The first clothing program will collect quality items, organize them carefully, and put them where they can actually be used.'
    when 'volunteer'
      assign hero_title = 'Give time where it can be used.'
      assign hero_intro = 'Volunteer opportunities will open when there is real work, clear responsibility, and the capacity to support people well.'
    when 'get-help'
      assign hero_title = 'Clear information. No false promises.'
      assign hero_intro = 'This page will always say what help is available, what is not available, and what someone can reasonably expect.'
    when 'about'
      assign hero_title = 'Real needs should lead to real action.'
      assign hero_intro = 'Real World Needs is being built to make the path from a genuine need to useful help easier to understand.'
    when 'donate'
      assign hero_title = 'Giving should be simple and clear.'
      assign hero_intro = 'Donation links appear only after the destination, legal language, receipts, and public disclosures are ready.'
  endcase
-%}

<section class="page-hero page-hero--{{ role | handle }}">
  <div class="rwn-section__inner page-hero__inner">
    <div class="page-hero__copy" data-reveal>
      <p class="section-label">{{ section.settings.kicker | escape }}</p>
      <h1>{{ hero_title | escape }}</h1>
      <p class="lead">{{ hero_intro | escape }}</p>
    </div>

    {%- case role -%}
      {%- when 'our-work', 'programs', 'about', 'volunteer' -%}
        <figure class="page-hero__media" data-reveal>
          <img src="{{ 'rwn-editorial-volunteers-boxes.jpg' | asset_url }}" width="2400" height="1600" alt="Two volunteers recording and organizing donated clothing" loading="eager">
          <figcaption>Editorial photography. Not a Real World Needs project record.</figcaption>
        </figure>
      {%- when 'give-clothing' -%}
        <figure class="page-hero__media" data-reveal>
          <img src="{{ 'rwn-editorial-clothing-room.jpg' | asset_url }}" width="2400" height="1600" alt="Volunteers checking and sorting donated clothing in a bright workspace" loading="eager">
          <figcaption>Editorial photography. Not a Real World Needs project record.</figcaption>
        </figure>
      {%- when 'transparency' -%}
        <div class="page-hero__principles" aria-label="Public record principles" data-reveal>
          <p>Public record by design</p>
          <ol><li>Open</li><li>Traceable</li><li>Verifiable</li><li>Accountable</li></ol>
        </div>
      {%- when 'needs' -%}
        <div class="page-hero__record-frame" aria-label="Future public need record" data-reveal><span>The need</span><span>The plan</span><span>The work</span><span>The result</span></div>
    {%- endcase -%}
  </div>
</section>

{%- if page.content != blank -%}
  <section class="page-admin-copy"><div class="page-reading-column rte">{{ page.content }}</div></section>
{%- endif -%}

{%- case role -%}
  {%- when 'needs' -%}
    <section class="rwn-section needs-page">
      <div class="rwn-section__inner">
        <header class="interior-heading" data-reveal><p class="section-label">Public projects</p><h2>This is where the work will live.</h2><p>No need is published just to fill the page. It appears when there is enough information to explain it responsibly.</p></header>
        {%- assign project_count = 0 -%}
        {%- if settings.projects_enabled and metaobjects.rwn_project.values != blank -%}
          <div class="need-grid" data-reveal>
            {%- for project in metaobjects.rwn_project.values -%}
              {%- assign project_title = project.title.value | default: project.title -%}
              {%- assign project_summary = project.short_summary.value | default: project.short_summary -%}
              {%- assign project_status = project.status.value | default: project.status -%}
              {%- assign project_location = project.location.value | default: project.location -%}
              {%- assign project_image = project.featured_image.value | default: project.featured_image -%}
              {%- if project_title != blank -%}
                {%- assign project_count = project_count | plus: 1 -%}
                <article class="need-card">{%- if project_image != blank and project.system.url != blank -%}<a class="need-card__media" href="{{ project.system.url }}">{{ project_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 720, 1000', alt: project_title }}</a>{%- endif -%}<div class="need-card__meta"><span>{{ project_status | default: 'Being reviewed' | escape }}</span>{%- if project_location != blank -%}<span>{{ project_location | escape }}</span>{%- endif -%}</div><h3>{{ project_title | escape }}</h3>{%- if project_summary != blank -%}<p>{{ project_summary | strip_html | truncate: 170 | escape }}</p>{%- endif -%}{%- if project.system.url != blank -%}<a class="text-link text-link--arrow" href="{{ project.system.url }}">View Project {% render 'rwn-icon', icon: 'arrow' %}</a>{%- endif -%}</article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if project_count == 0 -%}<div class="record-zero" data-reveal><div><p class="section-label">No public needs right now</p><h3>The first reviewed projects will appear here.</h3></div><p>Each record will show what is needed, who is responsible, how support can help, the current status, and what comes next.</p></div>{%- endif -%}
      </div>
    </section>

  {%- when 'our-work', 'programs' -%}
    <section class="rwn-section work-page">
      <div class="rwn-section__inner">
        <div class="work-page__current" data-reveal><p class="section-label">Current focus</p><h2>Clothing.</h2><p>Quality clothing already exists in closets, homes, businesses, and communities. The first program will focus on collecting it, sorting it well, and making it useful.</p>{% render 'rwn-page-link', handle: 'give-clothing', label: 'Give Clothing', class: 'text-link text-link--arrow' %}</div>
        <div class="work-index" data-reveal>
          <div><span>Being developed</span><h3>Needs and projects</h3><p>A clear record for direct work and projects supported through responsible partners.</p></div>
          <div><span>Future area</span><h3>Food</h3><p>Food access work needs real logistics, local knowledge, and clear reporting.</p></div>
          <div><span>Future area</span><h3>Clean water</h3><p>Water projects need qualified operators and results that can be verified.</p></div>
          <div><span>Future area</span><h3>Housing</h3><p>Housing support requires careful privacy, practical boundaries, and capable partners.</p></div>
          <div><span>Future area</span><h3>Emergency needs</h3><p>Urgent help still needs a responsible decision, a clear purpose, and a record.</p></div>
          <div><span>Future area</span><h3>Disaster response</h3><p>Future disaster work may happen directly or through organizations already equipped to respond.</p></div>
          <div><span>Future area</span><h3>Community projects</h3><p>Local improvements can become specific, trackable work with visible outcomes.</p></div>
        </div>
      </div>
    </section>

  {%- when 'how-it-works' -%}
    <section class="rwn-section process-page">
      <div class="rwn-section__inner">
        <ol class="process-page__list" data-reveal>
          <li><span>01 / Identify</span><h2>Start with something real.</h2><p>A need has to be specific enough to understand and responsible enough to share.</p></li>
          <li><span>02 / Verify</span><h2>Get the facts straight.</h2><p>Record what is known, what is uncertain, who is responsible, and what support could reasonably do.</p></li>
          <li><span>03 / Mobilize</span><h2>Bring together what helps.</h2><p>Useful support may be goods, volunteers, funding, professional skill, transportation, or the right partner.</p></li>
          <li><span>04 / Act</span><h2>Do the useful thing.</h2><p>Carry out the response directly or work with the organization best placed to do it.</p></li>
          <li><span>05 / Report</span><h2>Leave a public record.</h2><p>Show progress, spending where appropriate, the result, and anything still unfinished.</p></li>
        </ol>
      </div>
    </section>

  {%- when 'transparency' -%}
    {%- liquid
      assign active_project_count = 0
      assign completed_project_count = 0
      if settings.projects_enabled and metaobjects.rwn_project.values != blank
        for project in metaobjects.rwn_project.values
          assign record_status = project.status.value | default: project.status | downcase
          if record_status == 'completed' or record_status == 'closed'
            assign completed_project_count = completed_project_count | plus: 1
          else
            assign active_project_count = active_project_count | plus: 1
          endif
        endfor
      endif
    -%}
    <section class="rwn-section transparency-page">
      <div class="rwn-section__inner">
        <div class="transparency-timeline" data-reveal><div><p class="section-label">The record starts before the work</p><h2>Follow the whole process.</h2></div><ol><li>Need identified</li><li>Verified</li><li>Published</li><li>Funded</li><li>Work started</li><li>Updates posted</li><li>Completed</li><li>Final report published</li></ol></div>
        <div class="transparency-index" data-reveal>
          <header><p class="section-label">What will be published</p><h2>A place for every public record.</h2><p>Nothing appears before it exists. Nothing is filled with sample data to make the organization look established.</p></header>
          <div class="transparency-index__rows" role="table" aria-label="Transparency publication index">
            <div role="row"><strong role="cell">Current projects</strong><span role="cell">{% if active_project_count > 0 %}{{ active_project_count }} public record{% unless active_project_count == 1 %}s{% endunless %}{% else %}No public projects right now{% endif %}</span></div>
            <div role="row"><strong role="cell">Project spending</strong><span role="cell">No expense records published</span></div>
            <div role="row"><strong role="cell">Completed work</strong><span role="cell">{% if completed_project_count > 0 %}{{ completed_project_count }} completed record{% unless completed_project_count == 1 %}s{% endunless %}{% else %}No completed projects published{% endif %}</span></div>
            <div role="row"><strong role="cell">Financial reports</strong><span role="cell">No reports published</span></div>
            <div role="row"><strong role="cell">Government filings</strong><span role="cell">No filings published</span></div>
            <div role="row"><strong role="cell">Annual reports</strong><span role="cell">No annual report published</span></div>
            <div role="row"><strong role="cell">Audits</strong><span role="cell">No audit published</span></div>
            <div role="row"><strong role="cell">Governance</strong><span role="cell">Records will appear after review</span></div>
            <div role="row"><strong role="cell">Policies</strong><span role="cell">Records will appear after review</span></div>
            <div role="row"><strong role="cell">Leadership compensation</strong><span role="cell">No information published</span></div>
            <div role="row"><strong role="cell">Partner verification</strong><span role="cell">Published with applicable projects</span></div>
            <div role="row"><strong role="cell">Impact methodology</strong><span role="cell">No methodology published</span></div>
            <div role="row"><strong role="cell">Donation processing</strong><span role="cell">Published when donations are enabled</span></div>
          </div>
        </div>
      </div>
    </section>

  {%- when 'financials' -%}
    <section class="rwn-section"><div class="rwn-section__inner"><div class="record-zero" data-reveal><div><p class="section-label">Financial records</p><h2>No financial reports have been published yet.</h2></div><p>Annual reports, government filings, audits, and financial statements will appear here after they exist and are approved for public release.</p></div></div></section>

  {%- when 'donate' -%}
    <section class="rwn-section donate-page"><div class="rwn-section__inner"><div class="donate-page__standard" data-reveal><p class="section-label">Before giving opens</p><h2>The destination, receipt, and legal language all need to be ready.</h2><dl><div><dt>General giving</dt><dd>{% if donation_ready %}Enabled{% else %}Not enabled{% endif %}</dd></div><div><dt>Monthly giving</dt><dd>{% if monthly_donation_ready %}Enabled{% else %}Not enabled{% endif %}</dd></div><div><dt>Donation processor</dt><dd>{{ settings.donation_processor_name | default: 'Not configured' | escape }}</dd></div><div><dt>Tax language</dt><dd>{% if settings.tax_deductible_language_enabled and settings.tax_exempt_status_confirmed %}Administrator confirmed{% else %}Not displayed{% endif %}</dd></div></dl></div><div class="action-row">{%- if donation_ready -%}<a class="button button--primary" href="{{ settings.donation_url | escape }}">Continue to Donation Processor {% render 'rwn-icon', icon: 'arrow' %}</a>{%- endif -%}{%- if monthly_donation_ready -%}<a class="button button--secondary" href="{{ settings.monthly_donation_url | escape }}">Monthly Giving {% render 'rwn-icon', icon: 'arrow' %}</a>{%- endif -%}</div>{%- unless donation_ready or monthly_donation_ready -%}<div class="record-zero record-zero--compact"><div><h3>Online donations are not open right now.</h3></div><p>Donation buttons will appear after the destination and public language have been reviewed.</p></div>{%- endunless -%}</div></section>

  {%- when 'give-clothing' -%}
    <section class="rwn-section clothing-page"><div class="rwn-section__inner"><div class="clothing-page__standard" data-reveal><p class="section-label">The standard</p><h2>Donate what you would feel comfortable giving to someone you care about.</h2></div><div class="donation-guides" data-reveal><article><h3>What to donate</h3><ul><li>Clean children's and adult clothing</li><li>Coats and work clothing</li><li>Interview clothing</li><li>Shoes in usable condition</li><li>New socks</li><li>New underwear</li></ul></article><article><h3>What not to donate</h3><ul><li>Wet or moldy clothing</li><li>Heavily damaged items</li><li>Unsafe items</li><li>Anything someone cannot reasonably use</li></ul></article></div><ol class="clothing-page__process" data-reveal><li><span>01</span><h3>Collect</h3><p>Receive useful items under clear collection rules.</p></li><li><span>02</span><h3>Inspect</h3><p>Check condition and remove anything unsuitable.</p></li><li><span>03</span><h3>Sort</h3><p>Organize by size, type, season, and use.</p></li><li><span>04</span><h3>Prepare</h3><p>Make items easy to browse and choose.</p></li><li><span>05</span><h3>Distribute</h3><p>Offer clothing with dignity and choice.</p></li><li><span>06</span><h3>Document</h3><p>Record what moved and where it went.</p></li></ol><div class="record-zero" data-reveal><div><p class="section-label">Locations and drives</p><h3>No public clothing locations or drives are listed right now.</h3></div><p>Real addresses, dates, collection rules, and contact information will appear here after logistics are confirmed.</p></div></div></section>

  {%- when 'volunteer' -%}
    <section class="rwn-section volunteer-page"><div class="rwn-section__inner"><div class="opportunity-index" data-reveal><div><span>Potential opportunity</span><h3>Clothing sorting</h3><p>Inspect and organize donations when sorting sessions are scheduled.</p></div><div><span>Potential opportunity</span><h3>Distribution</h3><p>Help make useful clothing easy to browse and receive.</p></div><div><span>Potential opportunity</span><h3>Donation drives</h3><p>Support collection logistics in schools, businesses, and community groups.</p></div><div><span>Potential opportunity</span><h3>Transportation</h3><p>Move donated goods when routes and responsibility are clear.</p></div><div><span>Potential opportunity</span><h3>Photography</h3><p>Document real work respectfully and with permission.</p></div><div><span>Potential opportunity</span><h3>Professional skills</h3><p>Offer planning, logistics, writing, design, finance, or operational help.</p></div></div>{%- if settings.volunteer_applications_enabled -%}{% form 'contact', class: 'form-grid rwn-form' %}{%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">Your message was sent.</p>{%- endif -%}{{ form.errors | default_errors }}<input type="hidden" name="contact[subject]" value="Volunteer interest"><div class="field"><label for="VolunteerName">Name</label><input id="VolunteerName" name="contact[name]" autocomplete="name" required></div><div class="field"><label for="VolunteerEmail">Email</label><input id="VolunteerEmail" type="email" name="contact[email]" autocomplete="email" required></div><div class="field"><label for="VolunteerInterest">How would you like to help?</label><textarea id="VolunteerInterest" name="contact[body]" required></textarea></div><button class="button button--primary" type="submit">Send Volunteer Interest</button>{% endform %}{%- else -%}<div class="record-zero"><div><h3>Volunteer applications are not open right now.</h3></div><p>This page will update when there is real work and the capacity to support volunteers well.</p></div>{%- endif -%}</div></section>

  {%- when 'get-help' -%}
    <section class="rwn-section get-help-page"><div class="rwn-section__inner">{%- if settings.get_help_requests_enabled -%}{% form 'contact', class: 'form-grid rwn-form' %}{%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">Your message was sent.</p>{%- endif -%}{{ form.errors | default_errors }}<input type="hidden" name="contact[subject]" value="Help request information"><div class="field"><label for="HelpName">Name</label><input id="HelpName" name="contact[name]" autocomplete="name" required></div><div class="field"><label for="HelpEmail">Email</label><input id="HelpEmail" type="email" name="contact[email]" autocomplete="email" required></div><div class="field"><label for="HelpMessage">What information are you looking for?</label><textarea id="HelpMessage" name="contact[body]" required></textarea></div><p class="form-privacy">Do not send medical records, financial information, identification numbers, or urgent safety details through this form.</p><button class="button button--primary" type="submit">Send Message</button>{% endform %}{%- else -%}<div class="record-zero"><div><p class="section-label">Current availability</p><h2>No public help intake is open right now.</h2></div><p>Available services, who they are for, and how to ask for help will be published here when a program is ready. This page does not promise assistance that is not available.</p></div>{%- endif -%}</div></section>

  {%- when 'impact' -%}
    <section class="rwn-section"><div class="rwn-section__inner"><div class="record-zero"><div><p class="section-label">Impact</p><h2>There is no impact total to report yet.</h2></div><p>Verified project outcomes, completed work, and public reports will appear here after real work can be measured. No zero counters and no estimates.</p></div></div></section>

  {%- when 'about' -%}
    <section class="rwn-section about-page"><div class="rwn-section__inner"><div class="about-sequence" data-reveal><article><span>01 / Why it exists</span><h2>People should be able to see the whole path from need to result.</h2><p>Concern is common. What is harder is knowing what is needed, who can help, what action makes sense, and whether it worked.</p></article><article><span>02 / The mission</span><h2>Find genuine needs. Organize useful help. Show what happened.</h2><p>The language is plain because the work should be plain enough to understand.</p></article><article><span>03 / Starting small</span><h2>Begin with clothing. Learn in public. Grow carefully.</h2><p>The first program is a practical place to build responsible logistics, volunteer habits, and public reporting.</p></article><article><span>04 / The future</span><h2>A structure that can serve many kinds of need.</h2><p>Food, water, housing, emergency response, disaster work, and community projects may follow when the capacity is real.</p></article></div><div class="leadership-index" data-reveal><div><h3>Leadership</h3><p>No leadership profiles have been published yet.</p></div><div><h3>Board</h3><p>No board profiles have been published yet.</p></div></div></div></section>

  {%- when 'governance', 'leadership-board' -%}
    <section class="rwn-section"><div class="rwn-section__inner"><div class="transparency-index__rows" role="table" aria-label="Governance publication index"><div role="row"><strong role="cell">Governance documents</strong><span role="cell">None published</span></div><div role="row"><strong role="cell">Board information</strong><span role="cell">None published</span></div><div role="row"><strong role="cell">Leadership compensation</strong><span role="cell">None published</span></div><div role="row"><strong role="cell">Conflict of interest policy</strong><span role="cell">None published</span></div><div role="row"><strong role="cell">Partner policies</strong><span role="cell">None published</span></div></div></div></section>

  {%- when 'contact' -%}
    <section class="rwn-section contact-page"><div class="rwn-section__inner contact-page__grid"><div><p class="section-label">Contact</p><h2>Send a straightforward message.</h2><div class="contact-methods">{%- if settings.contact_email != blank -%}<a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a>{%- endif -%}{%- if settings.public_phone != blank -%}<a href="tel:{{ settings.public_phone | escape }}">{{ settings.public_phone | escape }}</a>{%- endif -%}{%- if settings.public_address != blank -%}<p>{{ settings.public_address | escape | newline_to_br }}</p>{%- endif -%}</div></div>{% form 'contact', class: 'form-grid rwn-form' %}{%- if form.posted_successfully? -%}<p class="form-status" tabindex="-1">Your message was sent.</p>{%- endif -%}{{ form.errors | default_errors }}<div class="field"><label for="ContactName">Name</label><input id="ContactName" name="contact[name]" autocomplete="name" required></div><div class="field"><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required></div><div class="field"><label for="ContactMessage">Message</label><textarea id="ContactMessage" name="contact[body]" required></textarea></div><button class="button button--primary" type="submit">Send Message</button>{% endform %}</div></section>

  {%- when 'faq' -%}
    <section class="rwn-section"><div class="rwn-section__inner faq-list"><details open><summary>Is Real World Needs active yet?</summary><p>Real World Needs is new. Clothing is the first planned focus. Public projects will appear only after there is enough information to share them responsibly.</p></details><details><summary>Can I donate money today?</summary><p>Donation buttons appear only when a real destination has been configured, tested, and reviewed.</p></details><details><summary>Can I donate clothing today?</summary><p>Approved collection locations and drive dates will appear on the Give Clothing page when they are ready.</p></details><details><summary>Where will project reports appear?</summary><p>Each project will have its own record. The Transparency page will also index public updates, expenses, reports, and outcomes.</p></details></div></section>

  {%- when 'legal', 'privacy-policy', 'terms-of-use', 'donation-policy', 'donation-refund-policy', 'shipping-policy', 'return-policy', 'accessibility' -%}
    <section class="rwn-section legal-page"><div class="page-reading-column">{%- if page.content == blank -%}<div class="record-zero record-zero--stacked"><div><p class="section-label">Review required</p><h2>This policy has not been published yet.</h2></div><p>Public policy language must match the real organization, its legal status, Shopify settings, donation processor, and merchandise fulfillment practices.</p></div>{%- endif -%}<dl class="legal-status"><div><dt>Organization status</dt><dd>{{ settings.organization_status_text | default: 'Not published' | escape }}</dd></div><div><dt>Federal tax status</dt><dd>{{ settings.federal_tax_status_text | default: 'Not published' | escape }}</dd></div><div><dt>Tax deductibility</dt><dd>{{ settings.tax_deductibility_status_text | default: 'Not published' | escape }}</dd></div><div><dt>Donation processor</dt><dd>{{ settings.donation_processor_name | default: 'Not configured' | escape }}</dd></div></dl></div></section>

  {%- else -%}
    {%- if page.content == blank -%}<section class="rwn-section"><div class="rwn-section__inner"><div class="record-zero"><div><h2>This page is ready for approved content.</h2></div><p>Nothing has been published here yet.</p></div></div></section>{%- endif -%}
{%- endcase -%}

{% schema %}
{
  "name": "RWN page",
  "settings": [
    {
      "type": "select",
      "id": "page_role",
      "label": "Page role",
      "default": "generic",
      "options": [
        { "value": "generic", "label": "Generic" },
        { "value": "needs", "label": "Needs" },
        { "value": "about", "label": "About" },
        { "value": "our-work", "label": "Our Work" },
        { "value": "programs", "label": "Programs" },
        { "value": "how-it-works", "label": "How It Works" },
        { "value": "impact", "label": "Impact" },
        { "value": "transparency", "label": "Transparency" },
        { "value": "financials", "label": "Financials" },
        { "value": "donate", "label": "Donate" },
        { "value": "give-clothing", "label": "Give Clothing" },
        { "value": "volunteer", "label": "Volunteer" },
        { "value": "get-help", "label": "Get Help" },
        { "value": "contact", "label": "Contact" },
        { "value": "faq", "label": "FAQ" },
        { "value": "governance", "label": "Governance" },
        { "value": "leadership-board", "label": "Leadership and Board" },
        { "value": "legal", "label": "Legal" },
        { "value": "privacy-policy", "label": "Privacy Policy" },
        { "value": "terms-of-use", "label": "Terms of Use" },
        { "value": "donation-policy", "label": "Donation Policy" },
