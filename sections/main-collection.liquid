<section class="collection-hero">
  <div class="rwn-section__inner collection-hero__inner">
    <div>
      <h1>{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="lead">{{ collection.description }}</div>
      {%- else -%}
        <p class="lead">Supporter merchandise, Printify products, and Shopify products appear here when they are published.</p>
      {%- endif -%}
    </div>
    {%- if collection.products_count > 0 -%}
      <div class="collection-hero__count">
        <span>{{ collection.products_count }}</span>
        <p>product{% unless collection.products_count == 1 %}s{% endunless %}</p>
      </div>
    {%- endif -%}
  </div>
</section>

<section class="rwn-section shop-section">
  <div class="rwn-section__inner">
    {%- if collection.products_count > 0 -%}
      {%- paginate collection.products by 16 -%}
        <div class="product-grid product-grid--catalog">
          {%- for product in collection.products -%}
            <article class="product-card product-card--storefront">
              <a href="{{ product.url | within: collection }}">
                {%- if product.featured_image -%}
                  {%- assign product_image_alt = product.featured_image.alt | default: product.title -%}
                  <div class="product-media">{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product_image_alt }}</div>
                {%- else -%}
                  <div class="product-media product-media--empty">Image not available</div>
                {%- endif -%}
                <h2>{{ product.title | escape }}</h2>
              </a>
              <div class="product-card__footer">
                <p class="price">{{ product.price | money }}</p>
                {%- unless product.available -%}<p class="status-label">Out of stock</p>{%- endunless -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Products pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="shop-empty shop-empty--catalog">
        <div>
          <h2>The shop is ready for real products.</h2>
          <p>Printify and Shopify products appear here after they are published and assigned to this collection.</p>
        </div>
        {%- unless collection.handle == 'all' -%}
          <a class="button button--primary" href="{{ routes.all_products_collection_url }}">View all products</a>
        {%- endunless -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RWN collection",
  "settings": []
}
{% endschema %}
